00082Cr 3  17 18        @Str1: .byte "NO"
00082Er 3               ; ===========================================================================
00082Er 3               
00082Er 3               ; pointers to menu values
00082Er 3  D3 13 50 90  MenuValueLocationsLo: .lobytes MenuValueLocations
000832r 3  D1 10        
000834r 3  20 21 21 21  MenuValueLocationsHi: .hibytes MenuValueLocations
000838r 3  21 22        
00083Ar 3  CA 0A 4A 8A  MenuTitleLocationsLo: .lobytes MenuTitleLocations
00083Er 3  CA 0A        
000840r 3  20 21 21 21  MenuTitleLocationsHi: .hibytes MenuTitleLocations
000844r 3  21 22        
000846r 3               
000846r 2               .include "utils.asm"
000846r 3               
000846r 3               ; ===========================================================================
000846r 3               ;  Base 10 addition
000846r 3               ; ---------------------------------------------------------------------------
000846r 3               ; Input:
000846r 3               ;   X - offset into base10 value list to add
000846r 3               ;   A - value to add
000846r 3               ; ---------------------------------------------------------------------------
000846r 3               B10Add:
000846r 3  18               clc                        ;
000847r 3  7D rr rr         adc MathDigits,x           ; add value to digit
00084Ar 3  9D rr rr         sta MathDigits,x           ; store result
00084Dr 3  C9 0A        :   cmp #10                    ; compare against 10
00084Fr 3  90 12            bcc @Done                  ; if less than 10, we're done
000851r 3  A9 00            lda #0                     ; otherwise, set to 0
000853r 3  9D rr rr         sta MathDigits,x           ; store result
000856r 3  E8               inx                        ; move to next digit
000857r 3  30 0A            bmi @Done                  ; if no more digits, we're done
000859r 3  BD rr rr         lda MathDigits,x           ; get next digit
00085Cr 3  69 00            adc #0                     ; add our carry
00085Er 3  9D rr rr         sta MathDigits,x           ; store result
000861r 3  90 EA            bcc :-                     ; and keep going until we don't have a carry
000863r 3               @Done:                         ;
000863r 3  60               rts                        ;
000864r 3               ; ===========================================================================
000864r 3               
000864r 3               ; ===========================================================================
000864r 3               ;  Divide A value by 10
000864r 3               ; ---------------------------------------------------------------------------
000864r 3               ;  Example:
000864r 3               ;  lda #145
000864r 3               ;  jsr B10DivideBy10
000864r 3               ;  ; A = 5   (remainder)
000864r 3               ;  ; X = 14  (quotient)
000864r 3               ; ---------------------------------------------------------------------------
000864r 3               B10DivBy10:
000864r 3  A2 00            ldx #$00                  ; clear result
000866r 3  C9 0A        :   cmp #$0a                  ; compare current value against 10
000868r 3  90 05            bcc @Done                 ; if lower, then we are finished
00086Ar 3  E9 0A            sbc #$0a                  ; otherwise subtract 10
00086Cr 3  E8               inx                       ; and increment result
00086Dr 3  D0 F7            bne :-                    ; keep looping
00086Fr 3               @Done:                        ;
00086Fr 3  60               rts                       ; done
000870r 3               ; ===========================================================================
000870r 3               
000870r 3               ; ================================================================
000870r 3               ;  6502 multiply by 10
000870r 3               ; ----------------------------------------------------------------
000870r 3               MultiplyBy10:
000870r 3  0A               asl                       ; multiply by 2
000871r 3  85 00            sta $0                    ; store in temp value
000873r 3  0A               asl                       ; multiply by 4
000874r 3  0A               asl                       ;
000875r 3  18               clc                       ;
000876r 3  65 00            adc $0                    ; add temp value, so, (A*2*4)+(A*2)
000878r 3  60               rts                       ; done
000879r 3               ; ================================================================
000879r 3               
000879r 3               ;; copied code from smb1
000879r 3               WriteVRAMBufferToScreen:
000879r 3  AD 00 03         lda VRAM_Buffer1_Offset
00087Cr 3  F0 2F            beq @Skip
00087Er 3  A0 03            ldy #>(VRAM_Buffer1)
000880r 3  84 01            sty $1
000882r 3  A0 01            ldy #<(VRAM_Buffer1)
000884r 3  84 00            sty $0
000886r 3  A0 00            ldy #0
000888r 3               @KeepWriting:
000888r 3  20 rr rr         jsr WriteBufferPtrToScreen
00088Br 3  B1 00            lda ($0),y
00088Dr 3  F0 10            beq @Done
00088Fr 3  18               clc
000890r 3  98               tya
000891r 3  65 00            adc $0
000893r 3  85 00            sta $0
000895r 3  A5 01            lda $1
000897r 3  69 00            adc #$0
000899r 3  85 01            sta $1
00089Br 3  A0 00            ldy #0
00089Dr 3  50 E9            bvc @KeepWriting
00089Fr 3               @Done:
00089Fr 3  A9 00            lda #0
0008A1r 3  8D 01 03         sta VRAM_Buffer1
0008A4r 3  8D 00 03         sta VRAM_Buffer1_Offset
0008A7r 3  8D 05 20         sta PPU_SCROLL_REG
0008AAr 3  8D 05 20         sta PPU_SCROLL_REG
0008ADr 3               @Skip:
0008ADr 3  60               rts
0008AEr 3               
0008AEr 3               WriteBufferPtrToScreen:
0008AEr 3  B1 00            lda ($0),y
0008B0r 3  C9 1F            cmp #$1F
0008B2r 3  90 19            bcc @Done
0008B4r 3  8D 06 20         sta PPU_ADDRESS
0008B7r 3  C8               iny
0008B8r 3  B1 00            lda ($0),y
0008BAr 3  8D 06 20         sta PPU_ADDRESS
0008BDr 3  C8               iny
0008BEr 3  B1 00            lda ($0),y
0008C0r 3  AA               tax
0008C1r 3  F0 0A            beq @Done
0008C3r 3               @Continue:
0008C3r 3  C8               iny
0008C4r 3  B1 00            lda ($0),y
0008C6r 3  8D 07 20         sta PPU_DATA
0008C9r 3  CA               dex
0008CAr 3  D0 F7            bne @Continue
0008CCr 3  C8               iny
0008CDr 3               @Done:
0008CDr 3  60               rts
0008CEr 3               
0008CEr 3               ReadJoypadsCurrent:
0008CEr 3  A9 01            lda #$01
0008D0r 3  8D 16 40         sta JOYPAD_PORT
0008D3r 3  8D rr rr         sta HeldButtons
0008D6r 3  4A               lsr a
0008D7r 3  8D 16 40         sta JOYPAD_PORT
0008DAr 3               @KeepReading:
