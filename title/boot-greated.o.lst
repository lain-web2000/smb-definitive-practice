000005r 2               
000005r 2               ; import some pointers from the smb rom
000005r 2               .import GL_ENTER
000005r 2               .import GetAreaDataAddrs
000005r 2               .import LoadAreaPointer
000005r 2               .import EndWorld1Thru7
000005r 2               .import NMIHandler
000005r 2               .import IRQHandler
000005r 2               .import InitializeBG_CHR
000005r 2               .import InitializeSPR_CHR
000005r 2               
000005r 2               ; Temporary WRAM space
000005r 2               .segment "TEMPWRAM"
000000r 2  00 00 00 00  WRAMSaveHeader: .byte $00, $00, $00, $00, $00
000004r 2  00           
000005r 2  00           HeldButtons: .byte $00
000006r 2  00           ReleasedButtons: .byte $00
000007r 2  00           LastReadButtons: .byte $00
000008r 2  00           PressedButtons: .byte $00
000009r 2  00           CachedChangeAreaTimer: .byte $00
00000Ar 2  00           LevelEnding: .byte $00
00000Br 2  00           IsPlaying: .byte $00
00000Cr 2  00           EnteringFromMenu: .byte $00
00000Dr 2  00           PendingScoreDrawPosition: .byte $00
00000Er 2  00           CachedITC: .byte $00
00000Fr 2  00           PREVIOUS_BANK: .byte $00
000010r 2               
000010r 2               ; Persistent WRAM space
000010r 2               .segment "MENUWRAM"
000000r 2               MathDigits:
000000r 2               MathFrameruleDigitStart:
000000r 2  00 00 00 00    .byte $00, $00, $00, $00, $00 ; selected framerule
000004r 2  00           
000005r 2               MathFrameruleDigitEnd:
000005r 2               MathInGameFrameruleDigitStart:
000005r 2  00 00 00 00    .byte $00, $00, $00, $00, $00 ; ingame framerule
000009r 2  00           
00000Ar 2               MathInGameFrameruleDigitEnd:
00000Ar 2               CustomAddressA:
00000Ar 2  00 00          .word $0000
00000Cr 2               CustomAddressB:
00000Cr 2  00 00          .word $0000
00000Er 2               
00000Er 2               ; $7E00-$7FFF - relocated bank switching code
00000Er 2               RelocatedCodeLocation = $7E00
00000Er 2               
00000Er 2               .segment "PRACTISE_PRG0"
000005r 2               ; ================================================================
000005r 2               ;  Full reset of title screen
000005r 2               ; ----------------------------------------------------------------
000005r 2               TitleResetInner:
000005r 2  A2 00            ldx #$00                           ; disable ppu
000007r 2  8E 00 20         stx PPU_CTRL_REG1                  ;
00000Ar 2  8E 01 20         stx PPU_CTRL_REG2                  ;
00000Dr 2  20 rr rr         jsr InitializeMemory               ; clear memory
000010r 2  20 rr rr         jsr ForceClearWRAM                 ; clear all wram state
000013r 2  A9 09            lda #9                             ; set starting framerule
000015r 2  8D rr rr         sta MathFrameruleDigitStart        ;
000018r 2  A9 AD            lda #$ad                           ; set default address display
00001Ar 2  8D rr rr         sta CustomAddressA                 ; $03ad (relative X position)
00001Dr 2  A9 03            lda #$03                           ; for address A
00001Fr 2  8D rr rr         sta CustomAddressA+1               ;
000022r 2  A9 05            lda #$05                           ; $0705 (x subspeed)
000024r 2  8D rr rr         sta CustomAddressB                 ; for address B
000027r 2  A9 07            lda #$07                           ;
000029r 2  8D rr rr         sta CustomAddressB+1               ;
00002Cr 2  AD 02 20     :   lda PPU_STATUS                     ; wait for vblank
00002Fr 2  10 FB            bpl :-                             ;
000031r 2               HotReset2:                             ;
000031r 2  A2 00            ldx #$00                           ; disable ppu again (this is called when resetting to the menu)
000033r 2  8E 00 20         stx PPU_CTRL_REG1                  ;
000036r 2  8E 01 20         stx PPU_CTRL_REG2                  ;
000039r 2  A2 FF            ldx #$FF                           ; clear stack
00003Br 2  9A               txs                                ;
00003Cr 2  AD 02 20     :   lda PPU_STATUS                     ; wait for vblank
00003Fr 2  10 FB            bpl :-                             ;
000041r 2  20 rr rr         jsr InitBankSwitchingCode          ; copy bankswitching code to wram
000044r 2  20 rr rr         jsr ReadJoypads                    ; read controller to prevent a held button at startup from registering
000047r 2  20 rr rr         jsr PrepareScreen                  ; load in palette and background
00004Ar 2  20 rr rr         jsr MenuReset                      ; reset main menu
00004Dr 2  A9 00            lda #0                             ; disable playing state
00004Fr 2  8D rr rr         sta IsPlaying                      ;
000052r 2  8D 05 20         sta PPU_SCROLL_REG                 ; clear scroll registers
000055r 2  8D 05 20         sta PPU_SCROLL_REG                 ;
000058r 2  A9 88            lda #%10001000                     ; enable ppu
00005Ar 2  8D 78 07         sta Mirror_PPU_CTRL_REG1           ;
00005Dr 2  8D 00 20         sta PPU_CTRL_REG1                  ;
000060r 2  4C rr rr     :   jmp :-                             ; infinite loop until NMI
000063r 2               ; ================================================================
000063r 2               
000063r 2               ; ================================================================
000063r 2               ;  Hot reset back to the title screen
000063r 2               ; ----------------------------------------------------------------
000063r 2               HotReset:
000063r 2  A9 00            lda #0                             ; kill any playing sounds
000065r 2  8D 15 40         sta SND_MASTERCTRL_REG             ;
000068r 2  20 rr rr         jsr InitializeMemory               ; clear memory
00006Br 2  4C rr rr         jmp HotReset2                      ; then jump to the shared reset code
00006Er 2               ; ================================================================
00006Er 2               
00006Er 2               ; ================================================================
00006Er 2               ;  Handle NMI interrupts while in the title screen
00006Er 2               ; ----------------------------------------------------------------
00006Er 2               TitleNMI:
00006Er 2  AD 78 07         lda Mirror_PPU_CTRL_REG1           ; disable nmi
000071r 2  29 7F            and #%01111111                     ;
000073r 2  8D 78 07         sta Mirror_PPU_CTRL_REG1           ; and update ppu state
000076r 2  8D 00 20         sta PPU_CTRL_REG1                  ;
000079r 2  2C 02 20         bit PPU_STATUS                     ; flip ppu status
00007Cr 2  20 rr rr         jsr WriteVRAMBufferToScreen        ; write any pending vram updates
00007Fr 2  A9 00            lda #0                             ; clear scroll registers
000081r 2  8D 05 20         sta PPU_SCROLL_REG                 ;
000084r 2  8D 05 20         sta PPU_SCROLL_REG                 ;
000087r 2  A9 02            lda #$02                           ; copy sprites
000089r 2  8D 14 40         sta SPR_DMA                        ;
00008Cr 2  20 rr rr         jsr ReadJoypads                    ; read controller state
00008Fr 2  20 rr rr         jsr MenuNMI                        ; and run menu code
000092r 2  A9 1A            lda #%00011010                     ; set ppu mask state for menu
000094r 2  8D 01 20         sta PPU_CTRL_REG2                  ;
000097r 2  AD 78 07         lda Mirror_PPU_CTRL_REG1           ; get ppu mirror state
00009Ar 2  09 80            ora #%10000000                     ; and reactivate nmi
00009Cr 2  8D 78 07         sta Mirror_PPU_CTRL_REG1           ; update ppu state
00009Fr 2  8D 00 20         sta PPU_CTRL_REG1                  ;
0000A2r 2  40               rti                                ; and we are done for the frame
0000A3r 2               
0000A3r 2               ; ================================================================
0000A3r 2               ;  Sets up the all the fixed graphics for the title screen
0000A3r 2               ; ----------------------------------------------------------------
0000A3r 2               PrepareScreen:
0000A3r 2  A9 3F            lda #$3F                           ; move ppu to palette memory
0000A5r 2  8D 06 20         sta PPU_ADDRESS                    ;
0000A8r 2  A9 00            lda #$00                           ;
0000AAr 2  8D 06 20         sta PPU_ADDRESS                    ;
0000ADr 2  A2 00            ldx #0                             ;
0000AFr 2  BD rr rr     :   lda MenuPalette,x                  ; and copy the menu palette
0000B2r 2  8D 07 20         sta PPU_DATA                       ;
0000B5r 2  E8               inx                                ;
0000B6r 2  E0 20            cpx #(MenuPaletteEnd-MenuPalette)  ;
0000B8r 2  D0 F5            bne :-                             ;
0000BAr 2  A9 20            lda #$20                           ; move ppu to nametable 0
0000BCr 2  8D 06 20         sta PPU_ADDRESS                    ;
0000BFr 2  A2 00            ldx #0                             ;
0000C1r 2  8E 06 20         stx PPU_ADDRESS                    ;
0000C4r 2  BD rr rr     :   lda BGDATA+$000,x                  ; and copy every page of menu data
0000C7r 2  8D 07 20         sta PPU_DATA                       ;
0000CAr 2  E8               inx                                ;
0000CBr 2  D0 F7            bne :-                             ;
0000CDr 2  BD rr rr     :   lda BGDATA+$100,x                  ;
0000D0r 2  8D 07 20         sta PPU_DATA                       ;
0000D3r 2  E8               inx                                ;
0000D4r 2  D0 F7            bne :-                             ;
0000D6r 2  BD rr rr     :   lda BGDATA+$200,x                  ;
0000D9r 2  8D 07 20         sta PPU_DATA                       ;
0000DCr 2  E8               inx                                ;
0000DDr 2  D0 F7            bne :-                             ;
0000DFr 2  BD rr rr     :   lda BGDATA+$300,x                  ;
0000E2r 2  8D 07 20         sta PPU_DATA                       ;
0000E5r 2  E8               inx                                ;
0000E6r 2  D0 F7            bne :-                             ;
0000E8r 2  60               rts                                ;
0000E9r 2               ; ================================================================
0000E9r 2               
0000E9r 2               ; ================================================================
0000E9r 2               ;  Clear RAM and temporary WRAM
0000E9r 2               ; ----------------------------------------------------------------
0000E9r 2               InitializeMemory:
0000E9r 2  A9 00            lda #0                             ; clear A and X
0000EBr 2  A2 00            ldx #0                             ;
0000EDr 2  95 00        :   sta $0000,x                        ; clear relevant memory addresses
0000EFr 2  9D 00 02         sta $0200,x                        ;
0000F2r 2  9D 00 03         sta $0300,x                        ;
0000F5r 2  9D 00 04         sta $0400,x                        ;
0000F8r 2  9D 00 05         sta $0500,x                        ;
0000FBr 2  9D 00 06         sta $0600,x                        ;
0000FEr 2  9D 00 07         sta $0700,x                        ;
000101r 2  9D 00 60         sta $6000,x                        ;
000104r 2  E8               inx                                ; and loop for 256 bytes
000105r 2  D0 E6            bne :-                             ;
000107r 2  60               rts                                ;
000108r 2               ; ================================================================
000108r 2               
000108r 2               ; ================================================================
000108r 2               ;  Reinitialize WRAM if needed
000108r 2               ; ----------------------------------------------------------------
000108r 2               InitializeWRAM:
000108r 2  A2 05            ldx #ROMSaveHeaderLen              ; get length of the magic wram header
00010Ar 2  BD rr rr     :   lda ROMSaveHeader,x                ; check every byte of the header
00010Dr 2  DD rr rr         cmp WRAMSaveHeader,x               ; does it match?
000110r 2  D0 04            bne ForceClearWRAM                 ; no - clear wram
000112r 2  CA               dex                                ; yes - check next byte
000113r 2  10 F5            bpl :-                             ;
000115r 2  60               rts                                ;
000116r 2               ; ================================================================
000116r 2               
000116r 2               ; ================================================================
000116r 2               ;  Clear WRAM state
000116r 2               ; ----------------------------------------------------------------
000116r 2               ForceClearWRAM:
000116r 2                   @Ptr = $0
000116r 2  A9 60            lda #$60                           ; set starting address to $6000
000118r 2  85 01            sta @Ptr+1                         ;
00011Ar 2  A0 00            ldy #0                             ;
00011Cr 2  84 00            sty @Ptr+0                         ;
00011Er 2  A2 80            ldx #$80                           ; and mark ending address at $8000
000120r 2  A9 00            lda #$00                           ; clear A
000122r 2  91 00        :   sta (@Ptr),y                       ; clear one byte of WRAM
000124r 2  C8               iny                                ; and advance
000125r 2  D0 FB            bne :-                             ; for 256 bytes
000127r 2  E6 01            inc @Ptr+1                         ; then advance to the next page
000129r 2  E4 01            cpx @Ptr+1                         ; check if we are at the ending page
00012Br 2  D0 F5            bne :-                             ; no - keep clearing data
00012Dr 2  A2 05            ldx #ROMSaveHeaderLen              ; otherwise copy the magic wram header
00012Fr 2  BD rr rr     :   lda ROMSaveHeader,x                ;
000132r 2  9D rr rr         sta WRAMSaveHeader,x               ;
000135r 2  CA               dex                                ;
000136r 2  10 F7            bpl :-                             ;
000138r 2  60               rts                                ;
000139r 2               ; ================================================================
000139r 2               
000139r 2               ; include all of the relevant title files
000139r 2               .include "practise.asm"
000139r 3               ; ===========================================================================
000139r 3               ;  Start the game!
000139r 3               ; ---------------------------------------------------------------------------
000139r 3               TStartGame:
000139r 3                   @FRDigits = (MathFrameruleDigitEnd-MathFrameruleDigitStart-1)
000139r 3  20 rr rr         jsr InitBankSwitchingCode                    ; copy utility code to WRAM
00013Cr 3  A2 04            ldx #@FRDigits                               ; set up framerule digits
00013Er 3               @KeepCopying:                                    ;
00013Er 3  BD rr rr         lda MathFrameruleDigitStart, x               ; copy each framerule digit from the menu
000141r 3  9D rr rr         sta MathInGameFrameruleDigitStart, x         ;
000144r 3  CA               dex                                          ;
000145r 3  10 F7            bpl @KeepCopying                             ;
000147r 3  18               clc                                          ;
000148r 3  A9 01            lda #1                                       ; set flag indicating we are entering from the menu
00014Ar 3  8D rr rr         sta EnteringFromMenu                         ;
00014Dr 3  8D 70 07         sta OperMode                                 ; set starting opermode to "gamemode"
000150r 3  8D rr rr         sta IsPlaying                                ; mark that we are in game mode
000153r 3  4A               lsr a                                        ; clear A
000154r 3  8D 72 07         sta OperMode_Task                            ; clear opermode task value
000157r 3  85 0E            sta GameEngineSubroutine                     ; clear game engine task
000159r 3  8D 47 07         sta TimerControl                             ; mark the game as running
00015Cr 3  8D rr rr         sta PendingScoreDrawPosition                 ; clear pending status bar draw flag
00015Fr 3  8D 00 20         sta PPU_CTRL_REG1                            ; diable rendering
000162r 3  8D 78 07         sta Mirror_PPU_CTRL_REG1                     ;
000165r 3  8D 01 20         sta PPU_CTRL_REG2                            ;
000168r 3  8D 15 40         sta $4015                                    ; silence music
00016Br 3  85 FC            sta EventMusicQueue                          ; stop music queue
00016Dr 3  AE rr rr         ldx SettablesWorld                           ; copy menu world number
000170r 3  8E 5F 07         stx WorldNumber                              ;
000173r 3  AE rr rr         ldx SettablesLevel                           ; copy menu level number
000176r 3  8E 5C 07         stx LevelNumber                              ;
000179r 3  AE rr rr         ldx SettablesPUP                             ; get menu powerup state
00017Cr 3  BD rr rr         lda @StatusSizes,x                           ; get player size based on menu state
00017Fr 3  8D 54 07         sta PlayerSize                               ; and update player size
000182r 3  BD rr rr         lda @StatusPowers,x                          ; get player power state based on menu state
000185r 3  8D 56 07         sta PlayerStatus                             ; and update player status
000188r 3  AD rr rr         lda SettablesHero                            ; set current player
00018Br 3  8D 53 07         sta SelectedPlayer                           ;
00018Er 3  AD rr rr         lda SettablesW9                              ; if world 9 not enabled, branch ahead
000191r 3  F0 05            beq @EndCopy                                 ;
000193r 3  A9 FF            lda #$ff                                     ; otherwise mark all worlds as completed
000195r 3  8D FA 07         sta CompletedWorlds                          ;
000198r 3               @EndCopy:                                        ;
000198r 3  A9 02            lda #$2                                      ; give player 3 lives
00019Ar 3  8D 5A 07         sta NumberofLives                            ;
00019Dr 3  A9 04            lda #$4                                      ; set the interval timer to a hardcoded value
00019Fr 3  8D 7F 07         sta IntervalTimerControl                     ;
0001A2r 3  EE 57 07         inc FetchNewGameTimerFlag                    ; tell the game to reload the game timer
0001A5r 3  A9 08            lda #$08                                     ; set number of games beaten
0001A7r 3  8D 07 60         sta GamesBeatenCount                         ; to always enable letter worlds
0001AAr 3  4C rr rr         jmp BANK_AdvanceToLevel                      ; transition to the wram code to start the game
0001ADr 3               @StatusSizes:
0001ADr 3  01 00 00 00  .byte $1, $0, $0, $0, $1, $1
0001B1r 3  01 01        
0001B3r 3               @StatusPowers:
0001B3r 3  00 01 02 00  .byte $0, $1, $2, $0, $1, $2
0001B7r 3  01 02        
0001B9r 3               ; ===========================================================================
0001B9r 3               
0001B9r 3               ; ===========================================================================
0001B9r 3               ;  Practise routine per frame routine
0001B9r 3               ; ---------------------------------------------------------------------------
0001B9r 3               PractiseNMI:
0001B9r 3  AD rr rr         lda EnteringFromMenu                         ; are we currently entering from the menu?
0001BCr 3  F0 01            beq @ClearPractisePrintScore                 ; no - then we can run our routine
0001BEr 3  60               rts                                          ; otherwise, we're loading, so just return
0001BFr 3               @ClearPractisePrintScore:                        ;
0001BFr 3  AD 00 03         lda VRAM_Buffer1_Offset                      ; check if we have pending ppu draws
0001C2r 3  D0 03            bne @IncrementFrameruleCounter               ; yes - skip ahead
0001C4r 3  8D rr rr         sta PendingScoreDrawPosition                 ; no - clear pending vram address for framerule drawing
0001C7r 3               @IncrementFrameruleCounter:                      ;
0001C7r 3  20 rr rr         jsr IncrementFrameruleCounter                ; increment the base10 framerule counter
0001CAr 3  20 rr rr         jsr CheckForLevelEnd                         ; run level transition handler
0001CDr 3  20 rr rr         jsr CheckJumpingState                        ; run jump handler
0001D0r 3  20 rr rr         jsr CheckAreaTimer                           ; run area transition timing handler
0001D3r 3  20 rr rr         jsr CheckForWorldEnd                         ; run end of world handler
0001D6r 3               @CheckUpdateStatusbarValues:                     ;
0001D6r 3  A5 09            lda FrameCounter                             ; get current frame counter
0001D8r 3  29 03            and #3                                       ; and just make sure we're in a specific 4 frame spot
0001DAr 3  C9 02            cmp #2                                       ;
0001DCr 3  D0 03            bne @CheckInput                              ; if not, skip ahead
0001DEr 3  20 rr rr         jsr RedrawHighFreqStatusbar                  ; otherwise update status bar
0001E1r 3               @CheckInput:                                     ;
0001E1r 3  AD 4A 07         lda JoypadBitMask                            ; get current joypad state
0001E4r 3  29 30            and #(Select_Button | Start_Button)          ; mask out all but select and start
0001E6r 3  F0 24            beq @Done                                    ; neither are held - nothing more to do here
0001E8r 3  20 rr rr         jsr ReadJoypads                              ; re-read joypad state, to avoid filtering from the game
0001EBr 3               @CheckForRestartLevel:                           ;
0001EBr 3  C9 28            cmp #(Up_Dir | Select_Button)                ; check if select + up are held
0001EDr 3  D0 0E            bne @CheckForReset                           ; no - skip ahead
0001EFr 3  A9 00            lda #0                                       ; yes - we are restarting the level
0001F1r 3  8D 00 20         sta PPU_CTRL_REG1                            ; disable screen rendering
0001F4r 3  8D 01 20         sta PPU_CTRL_REG2                            ;
0001F7r 3  20 rr rr         jsr InitializeMemory                         ; clear memory
0001FAr 3  4C rr rr         jmp TStartGame                               ; and start the game
0001FDr 3               @CheckForReset:                                  ;
0001FDr 3  C9 24            cmp #(Down_Dir | Select_Button)              ; check if select + down are held
0001FFr 3  D0 0B            bne @Done                                    ; no - skip ahead
000201r 3  A9 00            lda #0                                       ; yes - we are returning to the title screen
000203r 3  8D 00 20         sta PPU_CTRL_REG1                            ; disable screen rendering
000206r 3  8D 01 20         sta PPU_CTRL_REG2                            ;
000209r 3  4C rr rr         jmp HotReset                                 ; and reset the game
00020Cr 3               @Done:                                           ;
00020Cr 3  60               rts                                          ;
00020Dr 3               ; ===========================================================================
00020Dr 3               
00020Dr 3               ; ===========================================================================
00020Dr 3               ;  Handle new area loading loading
00020Dr 3               ; ---------------------------------------------------------------------------
00020Dr 3               PractiseEnterStage:
00020Dr 3                   @FRDigitCount = MathFrameruleDigitEnd - MathFrameruleDigitStart - 1
00020Dr 3  A9 03            lda #3                                       ; set life counter to four by default
00020Fr 3  8D 5A 07         sta NumberofLives                            ; so we can't lose the game
000212r 3  AD rr rr         lda EnteringFromMenu                         ; check if we're entering from the menu
000215r 3  F0 20            beq @SaveToMenu                              ; no, the player beat a level, update the menu state
000217r 3  38               sec                                          ; yes, the player is starting a new game
000218r 3  AD 60 07     	lda AreaNumber
00021Br 3  F0 09        	beq @DashOne
00021Dr 3  A5 09            lda FrameCounter                             ; we need to offset the frame counter a little bit
00021Fr 3  E9 06            sbc #6                                       ;
000221r 3  85 09            sta FrameCounter                             ;
000223r 3  4C rr rr     	jmp @QuickResume
000226r 3               @DashOne:
000226r 3  EE 5D 07     	inc Hidden1UpFlag
000229r 3  A5 09        	lda FrameCounter                             ; we need to offset the frame counter differently for dash one levels
00022Br 3  E9 05            sbc #5                                       ;
00022Dr 3  85 09            sta FrameCounter                             ;
00022Fr 3               @QuickResume:
00022Fr 3  20 rr rr         jsr RNGQuickResume                           ; and load the rng state
000232r 3  CE rr rr         dec EnteringFromMenu                         ; then mark that we've entered from the menu, so this doesn't happen again
000235r 3  F0 46            beq @Shared                                  ; and skip ahead to avoid saving the state for no reason
000237r 3               @SaveToMenu:                                     ;
000237r 3  AD rr rr         lda LevelEnding                              ; check if we are transitioning to a new level
00023Ar 3  F0 41            beq @Shared                                  ; no - skip ahead and enter the game
00023Cr 3  A2 04            ldx #@FRDigitCount                           ; yes - copy the framerule to the menu
00023Er 3  BD rr rr     :   lda MathInGameFrameruleDigitStart,x          ;
000241r 3  9D rr rr         sta MathFrameruleDigitStart,x                ;
000244r 3  CA               dex                                          ;
000245r 3  10 F7            bpl :-                                       ;
000247r 3  AD 5F 07         lda WorldNumber                              ; copy current world and level to the menu
00024Ar 3  AE FB 07         ldx HardWorldFlag                            ; check if we're in the letter worlds
00024Dr 3  F0 03            beq @SaveWorldNum                            ; if not, branch to save world number
00024Fr 3  18               clc                                          ; otherwise add 9 to internal world number
000250r 3  69 09            adc #$09                                     ; for world selection in menu and level restart
000252r 3               @SaveWorldNum:                                   ;
000252r 3  8D rr rr         sta SettablesWorld                           ;
000255r 3  AD 5C 07         lda LevelNumber                              ;
000258r 3  8D rr rr         sta SettablesLevel                           ;
00025Br 3  AD 54 07         lda PlayerSize                               ; get player powerup state
00025Er 3  0A               asl a                                        ; shift up a couple of bits to make room for powerup state
00025Fr 3  0A               asl a                                        ;
000260r 3  0D 56 07         ora PlayerStatus                             ; combine with powerup state
000263r 3  AA               tax                                          ; copy to X
000264r 3  BD rr rr         lda @PUpStates,x                             ; and get the menu selection values from the players current state
000267r 3  8D rr rr         sta SettablesPUP                             ; and write to menu powerup state
00026Ar 3  AD 53 07         lda SelectedPlayer                           ; save currently selected player
00026Dr 3  8D rr rr         sta SettablesHero                            ;
000270r 3  A2 00            ldx #$00                                     ; clear world 9 enable flag by default
000272r 3  AD FA 07         lda CompletedWorlds                          ; check completed worlds variable
000275r 3  C9 FF            cmp #$ff                                     ; if not all worlds marked as completed,
000277r 3  D0 01            bne @StoreW9Flag                             ; world 9 will not be marked as enabled
000279r 3  E8               inx                                          ; otherwise increment X for world 9 enable
00027Ar 3               @StoreW9Flag:                                    ;
00027Ar 3  8E rr rr         stx SettablesW9                              ;
00027Dr 3               @Shared:                                         ;
00027Dr 3  A9 00            lda #0                                       ; clear out some starting state
00027Fr 3  8D rr rr         sta CachedChangeAreaTimer                    ;
000282r 3  8D rr rr         sta LevelEnding                              ;
000285r 3  4C rr rr         jmp RedrawLowFreqStatusbar                   ; and update the status line
000288r 3               @PUpStates:
000288r 3  03           .byte $3                                         ; size = 0, status = 0. big vuln. mario
000289r 3  01           .byte $1                                         ; size = 0, status = 1. big super mario
00028Ar 3  02           .byte $2                                         ; size = 0, status = 2. big fire mario
00028Br 3  02           .byte $2                                         ; size = 0, status = 3. big fire mario, padding
00028Cr 3  00           .byte $0                                         ; size = 1, status = 0. small vuln. mario
00028Dr 3  05           .byte $5                                         ; size = 1, status = 1. small super mario
00028Er 3  06           .byte $6                                         ; size = 1, status = 2. small fire mario
00028Fr 3               ; ===========================================================================
00028Fr 3               
00028Fr 3               ; ===========================================================================
00028Fr 3               ;  Handle level transitions
00028Fr 3               ; ---------------------------------------------------------------------------
00028Fr 3               CheckForLevelEnd:
00028Fr 3  AD rr rr         lda LevelEnding                              ; have we already detected the level end?
000292r 3  D0 1E            bne @Done                                    ; if so - exit
000294r 3  AD 3C 07         lda ScreenRoutineTask
000297r 3  C9 07            cmp #7
000299r 3  F0 14            beq @LevelEnding
00029Br 3  AD 46 07         lda StarFlagTaskControl                      ; check the current starflag state
00029Er 3  C9 04            cmp #4                                       ; are we in the final starflag task?
0002A0r 3  D0 10            bne @Done                                    ; no - exit
0002A2r 3  AD 7F 07         lda IntervalTimerControl                     ; cache the current interval timer
0002A5r 3  8D rr rr         sta CachedITC                                ;
0002A8r 3  18               clc                                          ;
0002A9r 3  20 rr rr         jsr ChangeTopStatusXToRemains                ; change the 'X' in the title to 'R'
0002ACr 3  20 rr rr         jsr RedrawLowFreqStatusbar                   ; and redraw the status bar
0002AFr 3               @LevelEnding:
0002AFr 3  EE rr rr         inc LevelEnding                              ; yes - mark the level end as ended
0002B2r 3               @Done:                                           ;
0002B2r 3  60               rts                                          ;
0002B3r 3               ; ===========================================================================
0002B3r 3               
0002B3r 3               ; ===========================================================================
0002B3r 3               ;  Handle area transitions (pipes, etc)
0002B3r 3               ; ---------------------------------------------------------------------------
0002B3r 3               CheckAreaTimer:
0002B3r 3  AD rr rr         lda CachedChangeAreaTimer                    ; have we already handled the area change?
0002B6r 3  D0 15            bne @Done                                    ; yes - exit
0002B8r 3  AD DE 06         lda ChangeAreaTimer                          ; no - check if we should handle it
0002BBr 3  F0 10            beq @Done                                    ; no - exit
0002BDr 3  8D rr rr         sta CachedChangeAreaTimer                    ; yes - cache the timer value
0002C0r 3  AD 7F 07         lda IntervalTimerControl                     ; get the interval timer
0002C3r 3               @Store2:                                         ;
0002C3r 3  8D rr rr         sta CachedITC                                ; and cache it as well
0002C6r 3  18               clc                                          ;
0002C7r 3  20 rr rr         jsr ChangeTopStatusXToRemains                ; change the 'X' in the title to 'R'
0002CAr 3  20 rr rr         jsr RedrawLowFreqStatusbar                   ; and redraw the status bar
0002CDr 3               @Done:                                           ;
0002CDr 3  60               rts                                          ;
0002CEr 3               ; ===========================================================================
0002CEr 3               
0002CEr 3               ; ===========================================================================
0002CEr 3               ;  Handle end of castle transitions
0002CEr 3               ; ---------------------------------------------------------------------------
0002CEr 3               CheckForWorldEnd:
0002CEr 3  AD rr rr         lda LevelEnding                              ; have we already detected the level end?
0002D1r 3  F0 09            beq @CheckWorldEndTimer                      ; if not - check for world end timer
0002D3r 3  4A               lsr                                          ; shift A right to discard d0
0002D4r 3  D0 1D            bne @Done                                    ; if d1 is set - exit
0002D6r 3  AD 80 07         lda SelectTimer                              ; otherwise check for select timer
0002D9r 3  D0 08            bne @DisplayIntervalTimer                    ; if set, display mod 21 remainder
0002DBr 3  60               rts                                          ; otherwise leave
0002DCr 3               @CheckWorldEndTimer:                             ;
0002DCr 3  AD A1 07         lda WorldEndTimer                            ; check world end timer
0002DFr 3  C9 08            cmp #8                                       ; has it been set to 8 or greater?
0002E1r 3  90 10            bcc @Done                                    ; if not, leave
0002E3r 3               @DisplayIntervalTimer:                           ;
0002E3r 3  AD 7F 07         lda IntervalTimerControl                     ; cache the current interval timer
0002E6r 3  8D rr rr         sta CachedITC                                ;
0002E9r 3  18               clc                                          ;
0002EAr 3  20 rr rr         jsr ChangeTopStatusXToRemains                ; change the 'X' in the title to 'R'
0002EDr 3  20 rr rr         jsr RedrawLowFreqStatusbar                   ; and redraw the status bar
0002F0r 3  EE rr rr         inc LevelEnding                              ; yes - mark the level end as ended
0002F3r 3               @Done:
0002F3r 3  60               rts
0002F4r 3               
0002F4r 3               ; ===========================================================================
0002F4r 3               
0002F4r 3               ; ===========================================================================
0002F4r 3               ;  Handle player jumping
0002F4r 3               ; ---------------------------------------------------------------------------
0002F4r 3               CheckJumpingState:
0002F4r 3  AD 82 07         lda JumpSwimTimer                            ; check jump timer
0002F7r 3  C9 20            cmp #$20                                     ; is it the max value (player just jumped)
0002F9r 3  D0 03            bne @Done                                    ; no - exit
0002FBr 3  20 rr rr         jsr RedrawLowFreqStatusbar                   ; yes - redraw the status bar
0002FEr 3               @Done:                                           ;
0002FEr 3  60               rts                                          ; done!
0002FFr 3               ; ===========================================================================
0002FFr 3               
0002FFr 3               ; ===========================================================================
0002FFr 3               ;  Advance to the next base 10 framerule digit
0002FFr 3               ; ---------------------------------------------------------------------------
0002FFr 3               IncrementFrameruleCounter:
0002FFr 3                   @DigitOffset = (MathInGameFrameruleDigitStart-MathDigits)
0002FFr 3  AD 47 07         lda TimerControl                             ; check if the game is running
000302r 3  D0 0F            bne @Done                                    ; no - exit
000304r 3  AC 7F 07         ldy IntervalTimerControl                     ; get the interval timer
000307r 3  C0 01            cpy #1                                       ; are we at the end of the interval?
000309r 3  D0 08            bne @Done                                    ; no - exit
00030Br 3  18               clc                                          ;
00030Cr 3  A9 01            lda #1                                       ; we want to add 1 to the digits
00030Er 3  A2 05            ldx #@DigitOffset                            ; get the offset to the digit we are incrementing
000310r 3  4C rr rr         jmp B10Add                                   ; and run base 10 addition
000313r 3               @Done:                                           ;
000313r 3  60               rts                                          ;
000314r 3               ; ===========================================================================
000314r 3               
000314r 3               ; ===========================================================================
000314r 3               ;  Handle when the game wants to redraw the MARIO / TIME text at the top
000314r 3               ; ---------------------------------------------------------------------------
000314r 3               PractiseWriteTopStatusLine:
000314r 3  18               clc                                          ;
000315r 3  AC 00 03         ldy VRAM_Buffer1_Offset                      ; get current vram offset
000318r 3  A9 31            lda #(@TopStatusTextEnd-@TopStatusText+1)    ; get text length
00031Ar 3  6D 00 03         adc VRAM_Buffer1_Offset                      ; add to vram offset
00031Dr 3  8D 00 03         sta VRAM_Buffer1_Offset                      ; and store new offset
000320r 3  A2 00            ldx #0                                       ;
000322r 3               @CopyData:                                       ;
000322r 3  BD rr rr         lda @TopStatusText,x                         ; copy bytes of the status bar text to vram
000325r 3  99 01 03         sta VRAM_Buffer1,y                           ;
000328r 3  C8               iny                                          ; advance vram offset
000329r 3  E8               inx                                          ; advance text offset
00032Ar 3  E0 30            cpx #(@TopStatusTextEnd-@TopStatusText)      ; check if we're at the end
00032Cr 3  D0 F4            bne @CopyData                                ; if not, loop
00032Er 3  A9 00            lda #0                                       ; then set null terminator at the end
000330r 3  99 01 03         sta VRAM_Buffer1,y                           ;
000333r 3  EE 3C 07         inc ScreenRoutineTask                        ; and advance the screen routine task
000336r 3  60               rts                                          ; done
000337r 3               @TopStatusText:                                  ;
000337r 3  20 42 14 1B    .byte $20, $42,  20, "RULE x F    SOCK Ax "    ;
00033Br 3  1E 15 0E 24  
00033Fr 3  29 24 0F 24  
00034Er 3  20 59 04 1D    .byte $20, $59,   4, "TIME"                    ;
000352r 3  12 16 0E     
000355r 3  20 73 02 0B    .byte $20, $73,   2, "Bx"
000359r 3  29           
00035Ar 3  20 69 02 2E    .byte $20, $69,   2, $2e, $29                  ; coin that shows next to the coin counter
00035Er 3  29           
00035Fr 3  23 C0 7F AA    .byte $23, $c0, $7f, $aa                       ; tile attributes for the top row, sets palette
000363r 3  23 C2 01 B0    .byte $23, $c2, $01, %10110000                 ; set palette for the flashing coin
000367r 3               @TopStatusTextEnd:
000367r 3  00              .byte $00
000368r 3               ; ===========================================================================
000368r 3               
000368r 3               ; ===========================================================================
000368r 3               ;  Handle the game requesting redrawing the bottom status bar
000368r 3               ; ---------------------------------------------------------------------------
000368r 3               PractiseWriteBottomStatusLine:
000368r 3  AD 7F 07         lda IntervalTimerControl                     ; no, get the current interval timer
00036Br 3  8D rr rr         sta CachedITC                                ; and store it in the cached value
00036Er 3  20 rr rr         jsr RedrawLowFreqStatusbar                   ; redraw the status bar
000371r 3  EE 3C 07         inc ScreenRoutineTask                        ; and advance to the next smb screen routine
000374r 3  60               rts                                          ;
000375r 3               ; ===========================================================================
000375r 3               
000375r 3               ; ===========================================================================
000375r 3               ;  Place an "R" instead of "x" in the title screen during level transitions
000375r 3               ; ---------------------------------------------------------------------------
000375r 3               ChangeTopStatusXToRemains:
000375r 3  18               clc                                          ;
000376r 3  AD 00 03         lda VRAM_Buffer1_Offset                      ; get current vram offset
000379r 3  A8               tay                                          ;
00037Ar 3  69 04            adc #4                                       ; and advance it by 4
00037Cr 3  8D 00 03         sta VRAM_Buffer1_Offset                      ; store the new offset
00037Fr 3  A9 20            lda #$20                                     ; write the ppu address to update
000381r 3  99 01 03         sta VRAM_Buffer1+0, y                        ;
000384r 3  A9 47            lda #$47                                     ;
000386r 3  99 02 03         sta VRAM_Buffer1+1, y                        ;
000389r 3  A9 01            lda #1                                       ; we are writing a single byte
00038Br 3  99 03 03         sta VRAM_Buffer1+2, y                        ;
00038Er 3  A9 1B            lda #'R'                                     ; and that byte is an R
000390r 3  99 04 03         sta VRAM_Buffer1+3, y                        ;
000393r 3  A9 00            lda #0                                       ; set the null terminator
000395r 3  99 05 03         sta VRAM_Buffer1+4, y                        ;
000398r 3  60               rts                                          ; and finish
000399r 3               ; ===========================================================================
000399r 3               
000399r 3               ; ===========================================================================
000399r 3               ;  Redraw the status bar portion that updates less often
000399r 3               ; ---------------------------------------------------------------------------
000399r 3               RedrawLowFreqStatusbar:
000399r 3  18               clc                                          ;
00039Ar 3  AC rr rr         ldy PendingScoreDrawPosition                 ; check if we have a pending draw that hasn't been sent to the ppu
00039Dr 3  D0 19            bne @RefreshBufferX                          ; yes - skip ahead and refresh the buffer to avoid overloading the ppu
00039Fr 3  AC 00 03         ldy VRAM_Buffer1_Offset                      ; no - get the current buffer offset
0003A2r 3  C8               iny                                          ; increment past the ppu location
0003A3r 3  C8               iny                                          ;
0003A4r 3  C8               iny                                          ;
0003A5r 3  8C rr rr         sty PendingScoreDrawPosition                 ; and store it as our pending position
0003A8r 3  20 rr rr         jsr @PrintRule                               ; draw the current framerule value
0003ABr 3  AD 46 07     	lda StarFlagTaskControl						 ; is the timer counting down at the end of a normal level?
0003AEr 3  C9 02        	cmp #$02									 ; if yes, do not draw frame counter numbers, the vram buffer will cry.
0003B0r 3  F0 03        	beq @NoFC									 ;
0003B2r 3  20 rr rr         jsr @PrintFramecounter                       ; draw the current framecounter value
0003B5r 3               @NoFC:
0003B5r 3  A6 08            ldx ObjectOffset                             ; load object offset, our caller might expect it to be unchanged
0003B7r 3  60               rts                                          ; and exit
0003B8r 3               @RefreshBufferX:                                 ;
0003B8r 3  20 rr rr         jsr @PrintRuleDataAtY                        ; refresh pending framerule value
0003BBr 3  98               tya                                          ; get the buffer offset we're drawing to
0003BCr 3  69 09            adc #9                                       ; and shift over to the framecounter position
0003BEr 3  A8               tay                                          ;
0003BFr 3  20 rr rr         jsr @PrintFramecounterDataAtY                ; and then refresh the pending frame ounter value
0003C2r 3  A6 08            ldx ObjectOffset                             ; load object offset, our caller might expect it to be unchanged
0003C4r 3  60               rts                                          ; and exit
0003C5r 3               ; ---------------------------------------------------------------------------
0003C5r 3               ;  Copy current framerule number to VRAM
0003C5r 3               ; ---------------------------------------------------------------------------
0003C5r 3               @PrintRule:
0003C5r 3  AD 00 03         lda VRAM_Buffer1_Offset                      ; get the current buffer offset
0003C8r 3  A8               tay                                          ;
0003C9r 3  69 09            adc #(3+6)                                   ; shift over based on length of the framerule text
0003CBr 3  8D 00 03         sta VRAM_Buffer1_Offset                      ; store the ppu location of the framerule counter
0003CEr 3  A9 20            lda #$20                                     ;
0003D0r 3  99 01 03         sta VRAM_Buffer1,y                           ;
0003D3r 3  A9 62            lda #$62                                     ;
0003D5r 3  99 02 03         sta VRAM_Buffer1+1,y                         ;
0003D8r 3  A9 06            lda #$06                                     ; store the number of digits to draw
0003DAr 3  99 03 03         sta VRAM_Buffer1+2,y                         ;
0003DDr 3  C8               iny                                          ; increment past the ppu location
0003DEr 3  C8               iny                                          ;
0003DFr 3  C8               iny                                          ;
0003E0r 3  A9 00            lda #0                                       ; place our null terminator
0003E2r 3  99 07 03         sta VRAM_Buffer1+6,y                         ;
0003E5r 3  A9 24            lda #$24                                     ; and write a space past the framerule (masks out smb1 '0' after the score)
0003E7r 3  99 05 03         sta VRAM_Buffer1+4,y                         ;
0003EAr 3               @PrintRuleDataAtY:
0003EAr 3  AD rr rr         lda CachedITC                                ; get the interval timer for when we entered the room
0003EDr 3  99 06 03         sta VRAM_Buffer1+5,y                         ; and store it in the buffer
0003F0r 3  AD rr rr         lda MathInGameFrameruleDigitStart+3          ; then copy the framerule numbers into the buffer
0003F3r 3  99 01 03         sta VRAM_Buffer1+0,y                         ;
0003F6r 3  AD rr rr         lda MathInGameFrameruleDigitStart+2          ;
0003F9r 3  99 02 03         sta VRAM_Buffer1+1,y                         ;
0003FCr 3  AD rr rr         lda MathInGameFrameruleDigitStart+1          ;
0003FFr 3  99 03 03         sta VRAM_Buffer1+2,y                         ;
000402r 3  AD rr rr         lda MathInGameFrameruleDigitStart+0          ;
000405r 3  99 04 03         sta VRAM_Buffer1+3,y                         ;
000408r 3  60               rts                                          ;
000409r 3               ; ---------------------------------------------------------------------------
000409r 3               ;  Copy current frame number to VRAM
000409r 3               ; ---------------------------------------------------------------------------
000409r 3               @PrintFramecounter:
000409r 3  AD 00 03         lda VRAM_Buffer1_Offset                      ; get current vram offset
00040Cr 3  A8               tay                                          ;
00040Dr 3  69 06            adc #(3+3)                                   ; add 3 for vram offset, 3 for values to draw
00040Fr 3  8D 00 03         sta VRAM_Buffer1_Offset                      ; save new vram offset
000412r 3  A9 20            lda #$20                                     ; store the ppu location of the frame number
000414r 3  99 01 03         sta VRAM_Buffer1,y                           ;
000417r 3  A9 4A            lda #$4a                                     ;
000419r 3  99 02 03         sta VRAM_Buffer1+1,y                         ;
00041Cr 3  A9 03            lda #$03                                     ; store the number of digits to draw
00041Er 3  99 03 03         sta VRAM_Buffer1+2,y                         ;
000421r 3  C8               iny                                          ; advance y to the end of the buffer to write
000422r 3  C8               iny                                          ;
000423r 3  C8               iny                                          ;
000424r 3  A9 00            lda #0                                       ; place our null terminator
000426r 3  99 04 03         sta VRAM_Buffer1+3,y                         ;
000429r 3               @PrintFramecounterDataAtY:                       ;
000429r 3  A5 09            lda FrameCounter                             ; get the current frame number
00042Br 3  20 rr rr         jsr B10DivBy10                               ; divide by 10
00042Er 3  99 03 03         sta VRAM_Buffer1+2,y                         ; store remainder in vram buffer
000431r 3  8A               txa                                          ; get the result of the divide
000432r 3  20 rr rr         jsr B10DivBy10                               ; divide by 10
000435r 3  99 02 03         sta VRAM_Buffer1+1,y                         ; store remainder in vram buffer
000438r 3  8A               txa                                          ; get the result of the divide
000439r 3  99 01 03         sta VRAM_Buffer1+0,y                         ; and store it in vram
00043Cr 3  60               rts                                          ;
00043Dr 3               ; ===========================================================================
00043Dr 3               
00043Dr 3               ; ===========================================================================
00043Dr 3               ;  Update and draw status bar values
00043Dr 3               ; ---------------------------------------------------------------------------
00043Dr 3               RedrawHighFreqStatusbar:
00043Dr 3                   @SockSubX = $2                               ; memory locations that sockfolder is stored in
00043Dr 3                   @SockX    = $3                               ;
00043Dr 3  AD 00 03         lda VRAM_Buffer1_Offset                      ; check if there are pending ppu updates
000440r 3  F0 01            beq :+                                       ; no - skip ahead to update status bar
000442r 3  60               rts                                          ; yes - don't overload the ppu
000443r 3  20 rr rr     :   jsr RecalculateSockfolder                    ; calculate new sockfolder value
000446r 3               
000446r 3  A2 00            ldx #0                                       ; clear X
000448r 3  A9 20            lda #$20                                     ; write ppu location of status bar to vram buffer
00044Ar 3  9D 01 03         sta VRAM_Buffer1+0,x                         ;
00044Dr 3  A9 6E            lda #$6E                                     ;
00044Fr 3  9D 02 03         sta VRAM_Buffer1+1,x                         ;
000452r 3  A9 04            lda #4                                       ; write number of bytes to draw
000454r 3  9D 03 03         sta VRAM_Buffer1+2,x                         ;
000457r 3  A9 00            lda #0
000459r 3  9D 07 03         sta VRAM_Buffer1+3+3,x                       ; and write that byte to the vram buffer
00045Cr 3  9D 08 03         sta VRAM_Buffer1+3+4,x                       ; and write that byte to the vram buffer
00045Fr 3               
00045Fr 3  A5 03            lda @SockX                                   ; get sockfolder x position
000461r 3  29 0F            and #$0F                                     ; mask off the high nibble
000463r 3  9D 05 03         sta VRAM_Buffer1+3+1,x                       ; and write that byte to the vram buffer
000466r 3  A5 03        	lda @SockX
000468r 3  4A           	lsr
000469r 3  4A           	lsr
00046Ar 3  4A           	lsr
00046Br 3  4A           	lsr
00046Cr 3  9D 04 03     	sta VRAM_Buffer1+3+0,x
00046Fr 3  A5 02            lda @SockSubX                                ; get sockfolder subpixel x position
000471r 3  4A               lsr                                          ; and shift down to the low nibble
000472r 3  4A               lsr                                          ;
000473r 3  4A               lsr                                          ;
000474r 3  4A               lsr                                          ;
000475r 3  9D 06 03         sta VRAM_Buffer1+3+2,x                       ; and write that byte to the vram buffer
000478r 3               
000478r 3  AD 74 07         lda DisableScreenFlag                        ; hack!
00047Br 3  D0 7A            bne @skip
00047Dr 3  A5 00            lda $00
00047Fr 3  48               pha
000480r 3  A5 01            lda $01
000482r 3  48               pha
000483r 3  A0 07            ldy #(4+3)                                   ; update vram buffer offset to new location
000485r 3  A9 20            lda #$20                                     ; write ppu location of status bar to vram buffer
000487r 3  99 01 03         sta VRAM_Buffer1+0,y                         ;
00048Ar 3  A9 55            lda #$55                                     ;
00048Cr 3  99 02 03         sta VRAM_Buffer1+1,y                         ;
00048Fr 3  A9 03            lda #3                                       ; write number of bytes to draw
000491r 3  99 03 03         sta VRAM_Buffer1+2,y                         ;
000494r 3               
000494r 3  AD rr rr         lda CustomAddressA
000497r 3  85 00            sta $00
000499r 3  AD rr rr         lda CustomAddressA+1
00049Cr 3  85 01            sta $01
00049Er 3  A0 00            ldy #$00
0004A0r 3  B1 00            lda ($00),y
0004A2r 3  A0 07            ldy #(4+3)                                   ; update vram buffer offset to new location
0004A4r 3  20 rr rr         jsr B10DivBy10
0004A7r 3  99 06 03     	sta VRAM_Buffer1+3+2,y
0004AAr 3  8A               txa
0004ABr 3  20 rr rr         jsr B10DivBy10
0004AEr 3  99 05 03         sta VRAM_Buffer1+3+1,y                      ; and write that byte to the vram buffer
0004B1r 3  8A               txa
0004B2r 3  99 04 03         sta VRAM_Buffer1+3+0,y                       ; and write that byte to the vram buffer
0004B5r 3               
0004B5r 3  A0 0D            ldy #(4+3+3+3)                               ; update vram buffer offset to new location
0004B7r 3  A9 20            lda #$20                                     ; write ppu location of status bar to vram buffer
0004B9r 3  99 01 03         sta VRAM_Buffer1+0,y                         ;
0004BCr 3  A9 75            lda #$75                                     ;
0004BEr 3  99 02 03         sta VRAM_Buffer1+1,y                         ;
0004C1r 3  A9 03            lda #3                                       ; write number of bytes to draw
0004C3r 3  99 03 03         sta VRAM_Buffer1+2,y                         ;
0004C6r 3  A9 13            lda #(4+3+(3+3)*2)
0004C8r 3  8D 00 03         sta VRAM_Buffer1_Offset
0004CBr 3  A9 00            lda #0                                       ; write null terminator
0004CDr 3  8D 14 03         sta VRAM_Buffer1+(4+3+(3+3)*2)               ;
0004D0r 3               
0004D0r 3  AD rr rr     	lda CustomAddressB
0004D3r 3  85 00            sta $00
0004D5r 3  AD rr rr         lda CustomAddressB+1
0004D8r 3  85 01            sta $01
0004DAr 3  A0 00            ldy #$00
0004DCr 3  B1 00            lda ($00),y
0004DEr 3  A0 0D            ldy #(4+3+3+3)                               ; update vram buffer offset to new location
0004E0r 3  20 rr rr         jsr B10DivBy10
0004E3r 3  99 06 03     	sta VRAM_Buffer1+3+2,y
0004E6r 3  8A               txa
0004E7r 3  20 rr rr         jsr B10DivBy10
0004EAr 3  99 05 03         sta VRAM_Buffer1+3+1,y                      ; and write that byte to the vram buffer
0004EDr 3  8A               txa
0004EEr 3  99 04 03         sta VRAM_Buffer1+3+0,y                       ; and write that byte to the vram buffer
0004F1r 3  68               pla
0004F2r 3  85 01            sta $01
0004F4r 3  68               pla
0004F5r 3  85 00            sta $00
0004F7r 3               @skip:                                           ;
0004F7r 3  60               rts                                          ;
0004F8r 3               
0004F8r 3               ; ===========================================================================
0004F8r 3               
0004F8r 3               
0004F8r 3               ; ===========================================================================
0004F8r 3               ;  Calculate the current sockfolder value
0004F8r 3               ; ---------------------------------------------------------------------------
0004F8r 3               ; Sockfolder is effectively calculated by the following formula:
0004F8r 3               ;  Player_X_Position + ((0xFF - Player_Y_Position) / MaximumYSpeed) * MaximumXSpeed
0004F8r 3               ;
0004F8r 3               ; So that will give you the position that mario would be when he reaches the
0004F8r 3               ; bottom of the screen assuming the player is falling at full speed.
0004F8r 3               ;
0004F8r 3               ; Here's a little javascript snippet that creates a 16 bit lookup table of sockfolder values:
0004F8r 3               ;
0004F8r 3               ;; // NTSC:
0004F8r 3               ;; let max_x_speed = 0x0280; // maximum x speed in subpixels
0004F8r 3               ;; let max_y_speed = 0x04;   // maximum y speed in pixels
0004F8r 3               ;; // PAL:
0004F8r 3               ;; //let max_x_speed = 0x0300; // maximum x speed in subpixels
0004F8r 3               ;; //let max_y_speed = 0x05;   // maximum y speed in pixels
0004F8r 3               ;;
0004F8r 3               ;; let values = [];
0004F8r 3               ;; for (let i=0xFF; i>=0x00; --i) {
0004F8r 3               ;;     let value = Math.floor(i/max_y_speed)*max_x_speed;
0004F8r 3               ;;     let format = Math.round(value).toString(16).padStart(4,'0');
0004F8r 3               ;;     values.push('$' + format);
0004F8r 3               ;; };
0004F8r 3               ;;
0004F8r 3               ;; let items_per_row = 0x8;
0004F8r 3               ;; for (let i=0; i<(values.length/items_per_row); ++i) {
0004F8r 3               ;;     let start = i * items_per_row;
0004F8r 3               ;;     let end = (i * items_per_row) + items_per_row;
0004F8r 3               ;;     let line = values.slice(start, end).join(',')
0004F8r 3               ;;     console.log('.byte ' + line + ' ; range ' +  start.toString(16) + ' to ' + (end-1).toString(16));
0004F8r 3               ;; }
0004F8r 3               ;
0004F8r 3               ; ---------------------------------------------------------------------------
0004F8r 3               RecalculateSockfolder:
0004F8r 3                   @DataTemp = $4                               ; temp value used for some maths
0004F8r 3                   @DataSubX = $2                               ; sockfolder subpixel x value
0004F8r 3                   @DataX    = $3                               ; sockfolder pixel x value
0004F8r 3  AD 00 04         lda SprObject_X_MoveForce                    ; get subpixel x position
0004FBr 3  85 02            sta @DataSubX                                ; and store it in our temp data
0004FDr 3  A5 86            lda Player_X_Position                        ; get x position
0004FFr 3  85 03            sta @DataX                                   ; and store it in our temp data
000501r 3  A5 CE            lda Player_Y_Position                        ; get y position
000503r 3  49 FF            eor #$FF                                     ; invert the bits, now $FF is the top of the screen
000505r 3  4A               lsr a                                        ; divide pixel position by 8
000506r 3  4A               lsr a                                        ;
000507r 3  4A               lsr a                                        ;
000508r 3  90 0F            bcc @sock1                                   ; if we're on the top half of tile 'tile', we will land 2.5 pixels later.
00050Ar 3  48               pha                                          ; so store the current value
00050Br 3  18               clc                                          ;
00050Cr 3  A5 02            lda @DataSubX                                ; get subpixel x position
00050Er 3  69 80            adc #$80                                     ; and increase it by half
000510r 3  85 02            sta @DataSubX                                ; and store it back
000512r 3  A5 03            lda @DataX                                   ; get x position
000514r 3  69 02            adc #$02                                     ; and add 2 + carry value
000516r 3  85 03            sta @DataX                                   ; and store it back
000518r 3  68               pla                                          ; then restore our original value
000519r 3               @sock1:                                          ;
000519r 3  85 04            sta @DataTemp                                ; store this in our temp value
00051Br 3  0A               asl a                                        ; multiply by 4
00051Cr 3  0A               asl a                                        ;
00051Dr 3  65 04            adc @DataTemp                                ; and add the temp value
00051Fr 3  65 03            adc @DataX                                   ; then add our x position
000521r 3  85 03            sta @DataX                                   ; and store it back
000523r 3  60               rts                                          ;
000524r 3               ; ===========================================================================
000524r 3               
000524r 2               .include "menu.asm"
000524r 3               SettablesCount   = $6
000524r 3               MenuTextPtr      = $C3
000524r 3               MenuTextLen      = $C2
000524r 3               
000524r 3               .pushseg
000524r 3               .segment "MENUWRAM"
00000Er 3  00           MenuSelectedItem: .byte $00
00000Fr 3  00           MenuSelectedSubitem: .byte $00
000010r 3               Settables:
000010r 3  00           SettablesWorld: .byte $00
000011r 3  00           SettablesLevel: .byte $00
000012r 3  00           SettablesPUP:   .byte $00
000013r 3  00           SettablesHero:  .byte $00
000014r 3  00           SettablesW9:    .byte $00
000015r 3  00           SettablesRule:  .byte $00
000016r 3               .popseg
000524r 3               
000524r 3               ; names for each selection type
000524r 3               MenuTitles:
000524r 3  20 18 1B 15  .byte "WORLD   "
000528r 3  0D 24 24 24  
00052Cr 3  15 0E 1F 0E  .byte "LEVEL   "
000530r 3  15 24 24 24  
000534r 3  19 28 1E 19  .byte "P-UP    "
000538r 3  24 24 24 24  
00053Cr 3  11 0E 1B 18  .byte "HERO    "
000540r 3  24 24 24 24  
000544r 3  20 0A 1B 19  .byte "WARPS   "
000548r 3  1C 24 24 24  
00054Cr 3  1B 1E 15 0E  .byte "RULE    "
000550r 3  24 24 24 24  
000554r 3               
000554r 3               ; ppu position to draw each title
000554r 3               .define MenuTitleLocations \
000554r 3                   $20CA + ($40 * 0), \
000554r 3                   $20CA + ($40 * 1), \
000554r 3                   $20CA + ($40 * 2), \
000554r 3                   $20CA + ($40 * 3), \
000554r 3                   $20CA + ($40 * 4), \
000554r 3                   $20CA + ($40 * 5)
000554r 3               
000554r 3               ; ppu position to draw each value
000554r 3               .define MenuValueLocations \
000554r 3                   $20D3 + ($40 * 0) - 0, \
000554r 3                   $20D3 + ($40 * 1) - 0, \
000554r 3                   $20D3 + ($40 * 2) - 3, \
000554r 3                   $20D3 + ($40 * 3) - 3, \
000554r 3                   $20D3 + ($40 * 4) - 2, \
000554r 3                   $20D3 + ($40 * 5) - 3
000554r 3               
000554r 3               ; which routines to use to change each menu items value
000554r 3               UpdateSelectedValueJE:
000554r 3  98               tya
000555r 3  20 rr rr         jsr JumpEngine
000558r 3  rr rr            .word UpdateValueWorldNumber ; world
00055Ar 3  rr rr            .word UpdateValueLevelNumber ; level
00055Cr 3  rr rr            .word UpdateValuePUps        ; p-up
00055Er 3  rr rr            .word UpdateValueToggle      ; hero
000560r 3  rr rr            .word UpdateValueToggle      ; world 9
000562r 3  rr rr            .word UpdateValueFramerule   ; framerule
000564r 3               
000564r 3               ; which routines to use to draw each menu items value
000564r 3               DrawMenuValueJE:
000564r 3  98               tya
000565r 3  20 rr rr         jsr JumpEngine
000568r 3  rr rr            .word DrawValueWorld         ; world
00056Ar 3  rr rr            .word DrawValueNumber        ; level
00056Cr 3  rr rr            .word DrawValueString_PUp    ; p-up
00056Er 3  rr rr            .word DrawValueString_Hero   ; hero
000570r 3  rr rr            .word DrawValueString_W9     ; world 9
000572r 3  rr rr            .word DrawValueFramerule     ; framerule
000574r 3               
000574r 3               ; ===========================================================================
000574r 3               ;  Redraw menu
000574r 3               ; ---------------------------------------------------------------------------
000574r 3               DrawMenu:
000574r 3               MenuReset:
000574r 3                   @Temp = $10
000574r 3  A0 05            ldy #(SettablesCount-1)                  ; get number of menu items
000576r 3  84 10        :   sty @Temp                                ; store the current menu item
000578r 3  20 rr rr         jsr @DrawMenuTitle                       ; draw the title of the menu item
00057Br 3  A4 10            ldy @Temp                                ; restore the menu item
00057Dr 3  20 rr rr         jsr DrawMenuValueJE                      ; draw the value of the menu item
000580r 3  A4 10            ldy @Temp                                ; restore the menu item
000582r 3  88               dey                                      ; and decrement it
000583r 3  10 F1            bpl :-                                   ; if not done, keep drawing
000585r 3  60               rts                                      ; otherwise, exit
000586r 3               @DrawMenuTitle:
000586r 3  18               clc                                      ;
000587r 3  AD 00 03         lda VRAM_Buffer1_Offset                  ; get current vram offset position
00058Ar 3  AA               tax                                      ;
00058Br 3  69 08            adc #3+5                                 ; advance it based on how many bytes we will write
00058Dr 3  8D 00 03         sta VRAM_Buffer1_Offset                  ; and save it back
000590r 3  B9 rr rr         lda MenuTitleLocationsHi,y               ; set ppu location of the current item's title
000593r 3  9D 01 03         sta VRAM_Buffer1+0,x                     ;
000596r 3  B9 rr rr         lda MenuTitleLocationsLo,y               ;
000599r 3  9D 02 03         sta VRAM_Buffer1+1,x                     ;
00059Cr 3  A9 05            lda #5                                   ; store length of the title
00059Er 3  9D 03 03         sta VRAM_Buffer1+2,x                     ;
0005A1r 3  98               tya                                      ; copy the menu item index to A
0005A2r 3  2A               rol a                                    ; and multiply it by 8, the offsets of the title strings
0005A3r 3  2A               rol a                                    ;
0005A4r 3  2A               rol a                                    ;
0005A5r 3  A8               tay                                      ; and copy that back to Y
0005A6r 3  B9 rr rr         lda MenuTitles+0,y                       ; then write the title screen to the buffer
0005A9r 3  9D 04 03         sta VRAM_Buffer1+3,x                     ;
0005ACr 3  B9 rr rr         lda MenuTitles+1,y                       ;
0005AFr 3  9D 05 03         sta VRAM_Buffer1+4,x                     ;
0005B2r 3  B9 rr rr         lda MenuTitles+2,y                       ;
0005B5r 3  9D 06 03         sta VRAM_Buffer1+5,x                     ;
0005B8r 3  B9 rr rr         lda MenuTitles+3,y                       ;
0005BBr 3  9D 07 03         sta VRAM_Buffer1+6,x                     ;
0005BEr 3  B9 rr rr         lda MenuTitles+4,y                       ;
0005C1r 3  9D 08 03         sta VRAM_Buffer1+7,x                     ;
0005C4r 3  A9 00            lda #0                                   ; and end the buffer with null
0005C6r 3  9D 09 03         sta VRAM_Buffer1+8,x                     ;
0005C9r 3  60               rts                                      ;
0005CAr 3               ; ===========================================================================
0005CAr 3               
0005CAr 3               ; ===========================================================================
0005CAr 3               ;  Menu main loop
0005CAr 3               ; ---------------------------------------------------------------------------
0005CAr 3               MenuNMI:
0005CAr 3  20 rr rr         jsr DrawSelectionMarkers                 ; reposition the selection markers
0005CDr 3  18               clc                                      ;
0005CEr 3  AD rr rr         lda PressedButtons                       ; check current inputs
0005D1r 3  D0 01            bne @READINPUT                           ; if any buttons are held, check them
0005D3r 3  60               rts                                      ; otherwise there's nothing to do
0005D4r 3               @READINPUT:                                  ;
0005D4r 3  29 0F            and #Right_Dir|Left_Dir|Down_Dir|Up_Dir  ; are we holding a direction?
0005D6r 3  F0 09            beq @SELECT                              ; if not, check for select
0005D8r 3  AC rr rr         ldy MenuSelectedItem                     ; we are, get the current selected item
0005DBr 3  20 rr rr         jsr UpdateSelectedValueJE                ; update the value
0005DEr 3  4C rr rr         jmp @RenderMenu                          ; redraw the menu and exit
0005E1r 3               @SELECT:                                     ;
0005E1r 3  AD rr rr         lda PressedButtons                       ; check current inputs
0005E4r 3  C9 20            cmp #Select_Button                       ; are we holding select?
0005E6r 3  D0 13            bne @START                               ; if not, check for start
0005E8r 3  A2 00            ldx #0                                   ; we are changing selected menu item
0005EAr 3  8E rr rr         stx MenuSelectedSubitem                  ; clear selected subitem
0005EDr 3  EE rr rr         inc MenuSelectedItem                     ; and advance to the next item
0005F0r 3  AD rr rr         lda MenuSelectedItem                     ; then check if we've reached the final item
0005F3r 3  C9 06            cmp #SettablesCount                      ;
0005F5r 3  D0 03            bne :+                                   ; no - skip ahead
0005F7r 3  8E rr rr         stx MenuSelectedItem                     ; yes - clear the selected item
0005FAr 3  60           :   rts                                      ; and exit
0005FBr 3               @START:                                      ;
0005FBr 3  C9 10            cmp #Start_Button                        ; are we holding start?
0005FDr 3  D0 17            bne @DONE                                ; no - nothing to do, exit
0005FFr 3  A9 00            lda #0                                   ; yes - check held buttons
000601r 3  AE rr rr         ldx HeldButtons                          ;
000604r 3  E0 80            cpx #A_Button                            ; check if we're holding A
000606r 3  90 02            bcc :+                                   ; nope - skip ahead
000608r 3  A9 01            lda #1                                   ; yes - set flag for 122 frame offset
00060Ar 3  8D 0B 60     :   sta IncrementRNG_122                     ; save 122 frame offset flag
00060Dr 3  4C rr rr         jmp TStartGame                           ; and start the game
000610r 3               @RenderMenu:                                 ;
000610r 3  AC rr rr         ldy MenuSelectedItem                     ; get the current selected item
000613r 3  20 rr rr         jsr DrawMenu                             ; and redraw it
000616r 3               @DONE:                                       ;
000616r 3  60               rts                                      ; done
000617r 3               ; ===========================================================================
000617r 3               
000617r 3               
000617r 3               ; ===========================================================================
000617r 3               ;  Position the "cursors" of the menu at the correct location
000617r 3               ; ---------------------------------------------------------------------------
000617r 3               DrawSelectionMarkers:
000617r 3  A9 00            lda #$00                                 ; set palette attributes for sprites
000619r 3  8D 06 02         sta Sprite_Attributes + (1 * SpriteLen)  ;
00061Cr 3  A9 21            lda #$21                                 ;
00061Er 3  8D 0A 02         sta Sprite_Attributes + (2 * SpriteLen)  ;
000621r 3  A9 5B            lda #$5B                                 ; mushroom elevator for sprite 1
000623r 3  8D 05 02         sta Sprite_Tilenumber + (1 * SpriteLen)  ;
000626r 3  A9 27            lda #$27                                 ; set solid background for sprite 2
000628r 3  8D 09 02         sta Sprite_Tilenumber + (2 * SpriteLen)  ;
00062Br 3  A9 1E            lda #$1E                                 ; get initial Y position
00062Dr 3  AC rr rr         ldy MenuSelectedItem                     ; get current menu item
000630r 3  18           :   clc                                      ;
000631r 3  69 10            adc #$10                                 ; add 16px per menu item
000633r 3  88               dey                                      ; decrement loop value
000634r 3  10 FA            bpl :-                                   ; and loop until done
000636r 3  8D 04 02         sta Sprite_Y_Position + (1 * SpriteLen)  ; reposition sprite 1 (floating coin)
000639r 3  8D 08 02         sta Sprite_Y_Position + (2 * SpriteLen)  ; reposition sprite 2 (background color)
00063Cr 3  A9 A9            lda #$A9                                 ; get initial X position
00063Er 3  8D 07 02         sta Sprite_X_Position + (1 * SpriteLen)  ; reposition sprite 1 (floating coin)
000641r 3  E9 08            sbc #$8                                  ; offset by 8px for the background color
000643r 3  AC rr rr         ldy MenuSelectedSubitem                  ; get which subitem is selected
000646r 3  38           :   sec                                      ; then offset by another 8px per subitem
000647r 3  E9 08            sbc #$8                                  ;
000649r 3  88               dey                                      ; decrement loop value
00064Ar 3  10 FA            bpl :-                                   ; and loop until done
00064Cr 3  8D 0B 02         sta Sprite_X_Position + (2 * SpriteLen)  ; reposition sprite 2 (background color)
00064Fr 3  60               rts                                      ; done
000650r 3               ; ===========================================================================
000650r 3               
000650r 3               ; update selected world value
000650r 3               UpdateValueWorldNumber:
000650r 3  AE rr rr         ldx WorldCount         ; get number of worlds
000653r 3  AD rr rr         lda HeldButtons        ; check held buttons
000656r 3  29 40            and #B_Button          ; are we holding B?
000658r 3  F0 02            beq :+                 ; no - skip ahead
00065Ar 3  A2 FF            ldx #$FF               ; otherwise allow selecting any value
00065Cr 3  4C rr rr     :   jmp UpdateValueShared  ; update selected menu item
00065Fr 3               
00065Fr 3               ; update selected level value
00065Fr 3               UpdateValueLevelNumber:
00065Fr 3  AE rr rr         ldx LevelCount         ; get number of levels per world
000662r 3  AD rr rr         lda HeldButtons        ; check held buttons
000665r 3  29 40            and #B_Button          ; are we holding B?
000667r 3  F0 02            beq :+                 ; no - skip ahead
000669r 3  A2 FF            ldx #$FF               ; otherwise allow selecting any value
00066Br 3  4C rr rr     :   jmp UpdateValueShared  ; update selected menu item
00066Er 3               
00066Er 3               ; update selected powerup value
00066Er 3               UpdateValuePUps:
00066Er 3  A2 06            ldx #6                 ; there are 6 total states
000670r 3  4C rr rr         jmp UpdateValueShared  ; update selected menu item
000673r 3               
000673r 3               ; update toggleable option
000673r 3               UpdateValueToggle:
000673r 3  A2 02            ldx #2                 ; toggle between two options
000675r 3  4C rr rr         jmp UpdateValueShared  ; update selected menu item
000678r 3               
000678r 3               ; ===========================================================================
000678r 3               ; Update a single byte menu item
000678r 3               ; ---------------------------------------------------------------------------
000678r 3               ; Input:  Y   = menu item index
000678r 3               ;         X   = maximum allowed value
000678r 3               ; ---------------------------------------------------------------------------
000678r 3               UpdateValueShared:
000678r 3                   @Max = $0
000678r 3  86 00            stx @Max                          ; temp store max value
00067Ar 3  18               clc                               ;
00067Br 3  AD rr rr         lda PressedButtons                ; get current inputs
00067Er 3  29 06            and #Down_Dir|Left_Dir            ; check if we're pressing decrementing direction
000680r 3  D0 0D            bne @Decrement                    ; yes - skip ahead to decrement
000682r 3               @Increment:                           ; no - we are incrementing
000682r 3  B9 rr rr         lda Settables,y                   ; get current value of the menu item
000685r 3  69 01            adc #1                            ; increment it
000687r 3  C5 00            cmp @Max                          ; check if we're beyond the maximum value
000689r 3  90 13            bcc @Store                        ; no - skip ahead to store
00068Br 3  A9 00            lda #0                            ; yes - set to 0
00068Dr 3  F0 0F            beq @Store                        ; and store
00068Fr 3               @Decrement:                           ;
00068Fr 3  B9 rr rr         lda Settables,y                   ; get current value of the menu item
000692r 3  F0 05            beq @Wrap                         ; if it's 0, wrap around
000694r 3  38               sec                               ;
000695r 3  E9 01            sbc #1                            ; otherwise, decrement it
000697r 3  50 05            bvc @Store                        ; skip ahead to store
000699r 3               @Wrap:                                ;
000699r 3  A5 00            lda @Max                          ; wrap around to the maximum value + 1
00069Br 3  38               sec                               ; and decrement it by 1
00069Cr 3  E9 01            sbc #1                            ;
00069Er 3               @Store:                               ;
00069Er 3  99 rr rr         sta Settables,y                   ; store the new value
0006A1r 3  60               rts                               ;
0006A2r 3               ; ===========================================================================
0006A2r 3               
0006A2r 3               ; ===========================================================================
0006A2r 3               ; Modify the selected framerule
0006A2r 3               ; ---------------------------------------------------------------------------
0006A2r 3               UpdateValueFramerule:
0006A2r 3  18               clc                               ;
0006A3r 3  AE rr rr         ldx MenuSelectedSubitem           ; get selected digit offset
0006A6r 3  AD rr rr         lda PressedButtons                ; check inputs
0006A9r 3  29 03            and #Right_Dir|Left_Dir           ; are we pressing left/right
0006ABr 3  F0 11            beq @update_value                 ; no - skip to check if we're changing value
0006ADr 3  CA               dex                               ; yes - we are changing which digit is selected
0006AEr 3  AD rr rr         lda PressedButtons                ; get buttons again
0006B1r 3  C9 01            cmp #Right_Dir                    ; are we pressing right?
0006B3r 3  F0 02            beq @store_selected               ; yes - store X as new selected digit
0006B5r 3  E8               inx                               ; no - we are pressing left, increment twice to offset dex
0006B6r 3  E8               inx                               ;
0006B7r 3               @store_selected:                      ;
0006B7r 3  8A               txa                               ;
0006B8r 3  29 03            and #%11                          ; mask to valid framerule value
0006BAr 3  8D rr rr         sta MenuSelectedSubitem           ; and update selected digit
0006BDr 3  60               rts                               ; done - exit
0006BEr 3               @update_value:
0006BEr 3  BC rr rr         ldy MathFrameruleDigitStart,x     ; get the digit we're changing
0006C1r 3  AD rr rr         lda PressedButtons                ; and check inputs
0006C4r 3  C9 08            cmp #Up_Dir                       ; are we pressing up?
0006C6r 3  F0 07            beq @increase                     ; yes - increment digit
0006C8r 3  88               dey                               ; no - decrement digit
0006C9r 3  10 0B            bpl @store_value                  ; if we didn't underflow, store value
0006CBr 3  A0 09            ldy #9                            ; otherwise wrap back around to 9
0006CDr 3  D0 07            bne @store_value                  ; and store value
0006CFr 3               @increase:
0006CFr 3  C8               iny                               ; we're increment, so, increment Y
0006D0r 3  C0 0A            cpy #$A                           ; check if we overflowed
0006D2r 3  D0 02            bne @store_value                  ; no - store value
0006D4r 3  A0 00            ldy #0                            ; yes - wrap back around to 0
0006D6r 3               @store_value:
0006D6r 3  98               tya                               ;
0006D7r 3  9D rr rr         sta MathFrameruleDigitStart,x     ; and save the new digit
0006DAr 3  60               rts                               ; exit!
0006DBr 3               ; ===========================================================================
0006DBr 3               
0006DBr 3               ; ===========================================================================
0006DBr 3               ; Draws a menu item to screen
0006DBr 3               ; ---------------------------------------------------------------------------
0006DBr 3               DrawValueWorld:
0006DBr 3  18               clc                               ;
0006DCr 3  AD 00 03         lda VRAM_Buffer1_Offset           ; get current vram update offset
0006DFr 3  AA               tax                               ;
0006E0r 3  69 05            adc #5                            ; offset it based on how much we're writing
0006E2r 3  8D 00 03         sta VRAM_Buffer1_Offset           ; and store it back
0006E5r 3  B9 rr rr         lda MenuValueLocationsHi,y        ; get the ppu location of this menu item, and write to vram buffer
0006E8r 3  9D 01 03         sta VRAM_Buffer1+0,x              ;
0006EBr 3  B9 rr rr         lda MenuValueLocationsLo,y        ;
0006EEr 3  9D 02 03         sta VRAM_Buffer1+1,x              ;
0006F1r 3  A9 02            lda #2                            ; we're writing 1 number and possibly an indicator
0006F3r 3  9D 03 03         sta VRAM_Buffer1+2,x              ;
0006F6r 3  B9 rr rr         lda Settables,y                   ; get the value of the settable item
0006F9r 3  48               pha                               ; push to the stack so we can use it later
0006FAr 3  69 01            adc #1                            ; increment it, since we display 1-based numbers
0006FCr 3  C9 0A            cmp #$0a                          ; have we selected a 2J world?
0006FEr 3  90 02            bcc @DrawWorldNum                 ; no, draw world number as-is
000700r 3  E9 09            sbc #$09                          ; otherwise subtract 9 for display
000702r 3               @DrawWorldNum:                        ;
000702r 3  9D 04 03         sta VRAM_Buffer1+3,x              ; store the number to be drawn
000705r 3  68               pla                               ; get the value of the settable item again
000706r 3  C9 09            cmp #$09                          ; did we select a 2J world?
000708r 3  90 04            bcc @NoStarIcon                   ; no, put blank space instead of star icon
00070Ar 3  A9 9F            lda #$9f                          ; otherwise print a star to indicate 2J worlds
00070Cr 3  D0 02            bne @StoreStarIcon                ; branch ahead
00070Er 3               @NoStarIcon:                          ;
00070Er 3  A9 24            lda #$24                          ; blank space ID
000710r 3               @StoreStarIcon:                       ;
000710r 3  9D 05 03         sta VRAM_Buffer1+4,x              ; store star icon/blank space here
000713r 3  A9 00            lda #0                            ; and mark the end of the buffer
000715r 3  9D 06 03         sta VRAM_Buffer1+5,x              ;
000718r 3  60               rts                               ;
000719r 3               ; ===========================================================================
000719r 3               
000719r 3               ; ===========================================================================
000719r 3               ; Draws a menu item to screen
000719r 3               ; ---------------------------------------------------------------------------
000719r 3               DrawValueNumber:
000719r 3  18               clc                               ;
00071Ar 3  AD 00 03         lda VRAM_Buffer1_Offset           ; get current vram update offset
00071Dr 3  AA               tax                               ;
00071Er 3  69 04            adc #4                            ; offset it based on how much we're writing
000720r 3  8D 00 03         sta VRAM_Buffer1_Offset           ; and store it back
000723r 3  B9 rr rr         lda MenuValueLocationsHi,y        ; get the ppu location of this menu item, and write to vram buffer
000726r 3  9D 01 03         sta VRAM_Buffer1+0,x              ;
000729r 3  B9 rr rr         lda MenuValueLocationsLo,y        ;
00072Cr 3  9D 02 03         sta VRAM_Buffer1+1,x              ;
00072Fr 3  A9 01            lda #1                            ; we're writing 1 number
000731r 3  9D 03 03         sta VRAM_Buffer1+2,x              ;
000734r 3  B9 rr rr         lda Settables,y                   ; get the value of the settable item
000737r 3  69 01            adc #1                            ; and increment it, since we display 1-based numbers
000739r 3  9D 04 03         sta VRAM_Buffer1+3,x              ; store the number to be drawn
00073Cr 3  A9 00            lda #0                            ; and mark the end of the buffer
00073Er 3  9D 05 03         sta VRAM_Buffer1+4,x              ;
000741r 3  60               rts                               ;
000742r 3               ; ===========================================================================
000742r 3               
000742r 3               ; ===========================================================================
000742r 3               ; Draws the four digit framerule to screen
000742r 3               ; ---------------------------------------------------------------------------
000742r 3               DrawValueFramerule:
000742r 3  18               clc                               ;
000743r 3  AD 00 03         lda VRAM_Buffer1_Offset           ; get current vram update offset
000746r 3  AA               tax                               ;
000747r 3  69 07            adc #7                            ; offset it based on how much we're writing
000749r 3  8D 00 03         sta VRAM_Buffer1_Offset           ; and store it back
00074Cr 3  B9 rr rr         lda MenuValueLocationsHi, y       ; get the ppu location of this menu item, and write to vram buffer
00074Fr 3  9D 01 03         sta VRAM_Buffer1+0, x             ;
000752r 3  B9 rr rr         lda MenuValueLocationsLo, y       ;
000755r 3  9D 02 03         sta VRAM_Buffer1+1, x             ;
000758r 3  A9 04            lda #4                            ; we're writing 4 numbers
00075Ar 3  9D 03 03         sta VRAM_Buffer1+2, x             ;
00075Dr 3  AD rr rr         lda MathFrameruleDigitStart+0     ; copy each of the four digits to vram buffer
000760r 3  9D 07 03         sta VRAM_Buffer1+3+3, x           ;
000763r 3  AD rr rr         lda MathFrameruleDigitStart+1     ;
000766r 3  9D 06 03         sta VRAM_Buffer1+3+2, x           ;
000769r 3  AD rr rr         lda MathFrameruleDigitStart+2     ;
00076Cr 3  9D 05 03         sta VRAM_Buffer1+3+1, x           ;
00076Fr 3  AD rr rr         lda MathFrameruleDigitStart+3     ;
000772r 3  9D 04 03         sta VRAM_Buffer1+3+0, x           ;
000775r 3  A9 00            lda #0                            ; and mark the end of the buffer
000777r 3  9D 08 03         sta VRAM_Buffer1+3+4, x           ;
00077Ar 3  60               rts                               ;
00077Br 3               ; ===========================================================================
00077Br 3               
00077Br 3               ; ===========================================================================
00077Br 3               ; Draws a string from a pointer to screen
00077Br 3               ; ---------------------------------------------------------------------------
00077Br 3               DrawValueString:
00077Br 3  18               clc                               ;
00077Cr 3  AD 00 03         lda VRAM_Buffer1_Offset           ; get current vram update offset
00077Fr 3  AA               tax                               ;
000780r 3  65 C2            adc MenuTextLen                   ; offset it based on string length
000782r 3  69 03            adc #3                            ; and add 3 for the header
000784r 3  8D 00 03         sta VRAM_Buffer1_Offset           ; and store it back
000787r 3  B9 rr rr         lda MenuValueLocationsHi,y        ; get the ppu location of this menu item, and write to vram buffer
00078Ar 3  9D 01 03         sta VRAM_Buffer1+0,x              ;
00078Dr 3  B9 rr rr         lda MenuValueLocationsLo,y        ;
000790r 3  9D 02 03         sta VRAM_Buffer1+1,x              ;
000793r 3  A5 C2            lda MenuTextLen                   ; write the string length to vram buffer
000795r 3  9D 03 03         sta VRAM_Buffer1+2,x              ;
000798r 3  A0 00            ldy #0                            ; prepare iterator
00079Ar 3               @CopyNext:                            ;
00079Ar 3  B1 C3            lda (MenuTextPtr),y               ; copy a byte of the string to vram
00079Cr 3  9D 04 03         sta VRAM_Buffer1+3,x              ;
00079Fr 3  E8               inx                               ; increment vram offset
0007A0r 3  C8               iny                               ; increment string read offset
0007A1r 3  C4 C2            cpy MenuTextLen                   ; check if we're done
0007A3r 3  90 F5            bcc @CopyNext                     ; no - copy next byte
0007A5r 3  A9 00            lda #0                            ; and mark the end of the buffer
0007A7r 3  9D 05 03         sta VRAM_Buffer1+4, x             ;
0007AAr 3  60               rts                               ;
0007ABr 3               ; ===========================================================================
0007ABr 3               
0007ABr 3               ; ===========================================================================
0007ABr 3               ; Draws a powerup state to screen
0007ABr 3               ; ---------------------------------------------------------------------------
0007ABr 3               DrawValueString_PUp:
0007ABr 3  B9 rr rr         lda Settables,y                   ; get the selected powerup state
0007AEr 3  0A               asl a                             ; get offset into pointer table
0007AFr 3  AA               tax                               ;
0007B0r 3  BD rr rr         lda @Strings,x                    ; copy string pointer to menu text pointer
0007B3r 3  85 C3            sta MenuTextPtr                   ;
0007B5r 3  BD rr rr         lda @Strings+1,x                  ;
0007B8r 3  85 C4            sta MenuTextPtr+1                 ;
0007BAr 3  A9 05            lda #5                            ; set fixed string length
0007BCr 3  85 C2            sta MenuTextLen                   ;
0007BEr 3  4C rr rr         jmp DrawValueString               ; and draw the string
0007C1r 3               
0007C1r 3               @Strings:
0007C1r 3  rr rr        .word @Str0
0007C3r 3  rr rr        .word @Str1
0007C5r 3  rr rr        .word @Str2
0007C7r 3  rr rr        .word @Str3
0007C9r 3  rr rr        .word @Str4
0007CBr 3  rr rr        .word @Str5
0007CDr 3               
0007CDr 3  17 18 17 0E  @Str0: .byte "NONE "
0007D1r 3  24           
0007D2r 3  24 0B 12 10  @Str1: .byte " BIG "
0007D6r 3  24           
0007D7r 3  0F 12 1B 0E  @Str2: .byte "FIRE "
0007DBr 3  24           
0007DCr 3  17 18 17 0E  @Str3: .byte "NONE!"
0007E0r 3  2B           
0007E1r 3  24 0B 12 10  @Str4: .byte " BIG!"
0007E5r 3  2B           
0007E6r 3  0F 12 1B 0E  @Str5: .byte "FIRE!"
0007EAr 3  2B           
0007EBr 3               ; ===========================================================================
0007EBr 3               
