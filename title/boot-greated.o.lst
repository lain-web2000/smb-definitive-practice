000904r 3               JumpEngine:
000904r 3  84 00            sty $00
000906r 3  0A               asl          ;shift bit from contents of A
000907r 3  A8               tay
000908r 3  68               pla          ;pull saved return address from stack
000909r 3  85 04            sta $04      ;save to indirect
00090Br 3  68               pla
00090Cr 3  85 05            sta $05
00090Er 3  C8               iny
00090Fr 3  B1 04            lda ($04),y  ;load pointer from indirect
000911r 3  85 06            sta $06      ;note that if an RTS is performed in next routine
000913r 3  C8               iny          ;it will return to the execution before the sub
000914r 3  B1 04            lda ($04),y  ;that called this routine
000916r 3  85 07            sta $07
000918r 3  88               dey
000919r 3  88               dey
00091Ar 3  98               tya
00091Br 3  A4 00            ldy $00
00091Dr 3  6C 06 00         jmp ($06)    ;jump to the address we loaded
