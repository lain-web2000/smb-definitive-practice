001007r 3               
001007r 3               ; ================================================================
001007r 3               ;  Setup framerule RNG
001007r 3               ; ----------------------------------------------------------------
001007r 3               RNGQuickResume:
001007r 3  AD rr rr         lda MathFrameruleDigitStart+3        ; get hundreds and thousands digits of bcd framerule value
00100Ar 3  20 rr rr         jsr MultiplyBy10                     ;
00100Dr 3  6D rr rr         adc MathFrameruleDigitStart+2        ;
001010r 3  AA               tax                                  ; store in X
001011r 3  BD rr rr         lda resume_0,x                       ; get rng value from lookup table for this offset
001014r 3  8D A7 07         sta PseudoRandomBitReg+0             ;
001017r 3  BD rr rr         lda resume_1,x                       ;
00101Ar 3  8D A8 07         sta PseudoRandomBitReg+1             ;
00101Dr 3  BD rr rr         lda resume_2,x                       ;
001020r 3  8D A9 07         sta PseudoRandomBitReg+2             ;
001023r 3  BD rr rr         lda resume_3,x                       ;
001026r 3  8D AA 07         sta PseudoRandomBitReg+3             ;
001029r 3  BD rr rr         lda resume_4,x                       ;
00102Cr 3  8D AB 07         sta PseudoRandomBitReg+4             ;
00102Fr 3  BD rr rr         lda resume_5,x                       ;
001032r 3  8D AC 07         sta PseudoRandomBitReg+5             ;
001035r 3  BD rr rr         lda resume_6,x                       ;
001038r 3  8D AD 07         sta PseudoRandomBitReg+6             ;
00103Br 3               @FrameruleAdjust:
00103Br 3  AD rr rr         lda MathFrameruleDigitStart + 1      ; get ones and tens digits of bcd framerule value
00103Er 3  20 rr rr         jsr MultiplyBy10                     ;
001041r 3  6D rr rr         adc MathFrameruleDigitStart + 0      ;
001044r 3  A8               tay                                  ; store in Y
001045r 3  F0 03            beq @FrameAdjust                     ; if not set, we can skip ahead
001047r 3  20 rr rr         jsr FRStepRNGByY                     ; otherwise we advance the RNG based on the framerule value * 21
00104Ar 3               @FrameAdjust:
00104Ar 3  AC 0B 60         ldy IncrementRNG_122                 ; did we hold A or B for a frame offset?
00104Dr 3  F0 14            beq :+                               ; branch ahead if not
00104Fr 3  88               dey									 ; did we hold A for both quests patterns?
001050r 3  F0 0C            beq @BothQuestsRNG					 ; if so, branch ahead to offset rng
001052r 3  A0 FE            ldy #254							 ; otherwise set Y for 431 frames (254 + 177)
001054r 3  20 rr rr         jsr StepRNGByY						 ; and adjust rng for all stages patterns
001057r 3  A0 B1            ldy #177							 ; hallo :D
001059r 3  20 rr rr         jsr StepRNGByY                       ;
00105Cr 3  F0 05            beq :+                               ; unconditional branch when done
00105Er 3               @BothQuestsRNG:
00105Er 3  A0 7A            ldy #122                             ; set Y for 122 frames
001060r 3  20 rr rr         jsr StepRNGByY                       ; and adjust rng for both endings patterns
001063r 3  AE rr rr     :   ldx SettablesPUP                     ; check if player has selected a powerup
001066r 3  D0 01            bne :+                               ; yes - skip ahead to adjust rng
001068r 3  60               rts                                  ; no - we are done!
001069r 3  BC rr rr     :   ldy @FramerulePowerupAdjust-1,x      ; check rng steps for current powerup value
00106Cr 3  20 rr rr         jsr StepRNGByY                       ; and adjust the rng for this value
00106Fr 3  CA               dex                                  ; decrement to next powerup value
001070r 3  D0 F7            bne :-                               ; and loop until we reach small mario state
001072r 3  60               rts                                  ; then we are done!
001073r 3               @FramerulePowerupAdjust:
001073r 3  3B               .byte 59                            ; fr pause from grabbing mushroom
001074r 3  3F               .byte 63                            ; fr pause from grabbing fireflower
001075r 3  BF               .byte 254 - 63                      ; fr pause from small fire (minus fr pause from grabbing fire)
001076r 3  3B               .byte 59                            ; fr pause from grabbing mushroom
001077r 3  3F               .byte 63                            ; fr pause from grabbing fireflower
001078r 3               ; ================================================================
001078r 3               
001078r 3               ; ================================================================
001078r 3               ;  Advance RNG by Y framerules
001078r 3               ; ----------------------------------------------------------------
001078r 3               FRStepRNGByY:
001078r 3  20 rr rr         jsr FRStepRNG
00107Br 3  88               dey
00107Cr 3  D0 FA            bne FRStepRNGByY
00107Er 3  60               rts
00107Fr 3               ; ================================================================
00107Fr 3               
00107Fr 3               ; ================================================================
00107Fr 3               ;  Advance RNG by Y frames
00107Fr 3               ; ----------------------------------------------------------------
00107Fr 3               StepRNGByY:
00107Fr 3  20 rr rr         jsr SingleStepRNG
001082r 3  88               dey
001083r 3  D0 FA            bne StepRNGByY
001085r 3  60               rts
001086r 3               ; ================================================================
001086r 3               
001086r 3               ; ================================================================
001086r 3               ;  Advance RNG by 21 frames
001086r 3               ; ----------------------------------------------------------------
001086r 3               FRStepRNG:
001086r 3  20 rr rr         jsr SingleStepRNG
001089r 3  20 rr rr         jsr SingleStepRNG
00108Cr 3  20 rr rr         jsr SingleStepRNG
00108Fr 3  20 rr rr         jsr SingleStepRNG
001092r 3  20 rr rr         jsr SingleStepRNG
001095r 3  20 rr rr         jsr SingleStepRNG
001098r 3  20 rr rr         jsr SingleStepRNG
00109Br 3  20 rr rr         jsr SingleStepRNG
00109Er 3  20 rr rr         jsr SingleStepRNG
0010A1r 3  20 rr rr         jsr SingleStepRNG
0010A4r 3  20 rr rr         jsr SingleStepRNG
0010A7r 3  20 rr rr         jsr SingleStepRNG
0010AAr 3  20 rr rr         jsr SingleStepRNG
0010ADr 3  20 rr rr         jsr SingleStepRNG
0010B0r 3  20 rr rr         jsr SingleStepRNG
0010B3r 3  20 rr rr         jsr SingleStepRNG
0010B6r 3  20 rr rr         jsr SingleStepRNG
0010B9r 3  20 rr rr         jsr SingleStepRNG
0010BCr 3  20 rr rr         jsr SingleStepRNG
0010BFr 3  20 rr rr         jsr SingleStepRNG
0010C2r 3  4C rr rr         jmp SingleStepRNG
0010C5r 3               ; ================================================================
0010C5r 3               
0010C5r 3               ; ================================================================
0010C5r 3               ;  Advance RNG by a single game frame
0010C5r 3               ; ----------------------------------------------------------------
0010C5r 3               SingleStepRNG:
0010C5r 3  48               pha
0010C6r 3  AD A7 07         lda PseudoRandomBitReg         ; get first memory location of LSFR bytes
0010C9r 3  29 02            and #%00000010                 ; mask out all but d1
0010CBr 3  85 00            sta $00                        ; save here
0010CDr 3  AD A8 07         lda PseudoRandomBitReg+1       ; get second memory location
0010D0r 3  29 02            and #%00000010                 ; mask out all but d1
0010D2r 3  45 00            eor $00                        ; perform exclusive-OR on d1 from first and second bytes
0010D4r 3  18               clc                            ; if neither or both are set, carry will be clear
0010D5r 3  F0 01            beq RotPRandomBit
0010D7r 3  38               sec                            ; if one or the other is set, carry will be set
0010D8r 3               RotPRandomBit:
0010D8r 3  6E A7 07         ror PseudoRandomBitReg+0       ; rotate carry into d7, and rotate last bit into carry
0010DBr 3  6E A8 07         ror PseudoRandomBitReg+1       ; rotate carry into d7, and rotate last bit into carry
0010DEr 3  6E A9 07         ror PseudoRandomBitReg+2       ; rotate carry into d7, and rotate last bit into carry
0010E1r 3  6E AA 07         ror PseudoRandomBitReg+3       ; rotate carry into d7, and rotate last bit into carry
0010E4r 3  6E AB 07         ror PseudoRandomBitReg+4       ; rotate carry into d7, and rotate last bit into carry
0010E7r 3  6E AC 07         ror PseudoRandomBitReg+5       ; rotate carry into d7, and rotate last bit into carry
0010EAr 3  6E AD 07         ror PseudoRandomBitReg+6       ; rotate carry into d7, and rotate last bit into carry
0010EDr 3  68               pla
0010EEr 3  60               rts
0010EFr 3               ; ================================================================
0010EFr 3               
0010EFr 2               
0010EFr 2               ; magic save header for WRAM
0010EFr 2               ROMSaveHeader:
0010EFr 2  03 20 07 21  .byte $03, $20, $07, $21, $03
0010F3r 2  03           
0010F4r 2               ROMSaveHeaderEnd:
0010F4r 2               ROMSaveHeaderLen = ROMSaveHeaderEnd-ROMSaveHeader
0010F4r 2               
0010F4r 1               
0010F4r 1               .segment "INES"
000000r 1               ; MMC3 INES header
000000r 1               INES_MAPPER = 4 << 4
000000r 1               INES_BATTERY = %00000010
000000r 1               INES_VERTICAL_MIRROR = %00000001
000000r 1  4E 45 53 1A  .byte $4E,$45,$53,$1A ; NES
000004r 1  08           .byte 8               ; prg banks
000005r 1  02           .byte 2               ; chr banks
000006r 1  43           .byte INES_MAPPER | INES_BATTERY | INES_VERTICAL_MIRROR
000007r 1               
000007r 1               ;.segment "PRACTISE_PRG0"
000007r 1               ;TitleMMC3NMI:
000007r 1               ;    jsr BANK_GAME_RTS
000007r 1               ;    jmp RELOCATE_NonMaskableInterrupt
000007r 1               
000007r 1               .segment "PRACTISE_PRG2"
000000r 1               ; ================================================================
000000r 1               ;  Boot game into title screen
000000r 1               ; ----------------------------------------------------------------
000000r 1               ColdTitleReset:
000000r 1  78               sei                       ; 6502 init
000001r 1  D8               cld                       ;
000002r 1  A2 FF            ldx #$FF                  ; clear stack
000004r 1  9A               txs                       ;
000005r 1  A9 C0            lda #$c0                  ; disable APU IRQs
000007r 1  8D 17 40     	sta JOYPAD_PORT2          ;
00000Ar 1  A9 80            lda #PractiseBank         ; init greated mapper state
00000Cr 1  A2 06            ldx #$06                  ;
00000Er 1  8E 00 80         stx $8000                 ;
000011r 1  8D 01 80         sta $8001                 ;
000014r 1  20 rr rr         jsr InitializeBG_CHR      ; init CHR banks
000017r 1  20 rr rr         jsr InitializeSPR_CHR     ;
00001Ar 1  4C rr rr         jmp TitleReset2           ; and prepare the title screen
00001Dr 1               ; ----------------------------------------------------------------
00001Dr 1               
00001Dr 1               ; the following code is copied to battery backed ram
00001Dr 1               .segment "PRACTISE_WRAMCODE"
0000A0r 1               
0000A0r 1               BANK_GAME_NMI:
0000A0r 1  AD rr rr         lda IsPlaying
0000A3r 1  D0 06            bne @InGameMode
0000A5r 1  20 rr rr         jsr BANK_TITLE_RTS
0000A8r 1  4C rr rr         jmp TitleNMI
0000ABr 1               @InGameMode:
0000ABr 1  20 rr rr         jsr BANK_GAME_RTS
0000AEr 1  4C rr rr         jmp RELOCATE_NonMaskableInterrupt
0000B1r 1               
0000B1r 1               ; ================================================================
0000B1r 1               ;  Handle loading new level banks
0000B1r 1               ; ----------------------------------------------------------------
0000B1r 1               BANK_LEVELBANK_RTS:
0000B1r 1  48               pha                     ; save whatever A value we were called with
0000B2r 1  A9 06            lda #6                  ; set mmc state
0000B4r 1  8D 00 80         sta $8000               ;
0000B7r 1  A9 8A            lda #LevelsBank         ;
0000B9r 1  8D 01 80         sta $8001               ; set bank
0000BCr 1  A9 07            lda #7                  ;
0000BEr 1  8D 00 80         sta $8000               ;
0000C1r 1  A9 8B            lda #LevelsBank+1       ;
0000C3r 1  8D 01 80         sta $8001               ;
0000C6r 1  68               pla                     ; restore the A value we were called with
0000C7r 1  60               rts                     ;
0000C8r 1               ; ================================================================
0000C8r 1               
0000C8r 1               ; ================================================================
0000C8r 1               ;  Load into game bank and return control
0000C8r 1               ; ----------------------------------------------------------------
0000C8r 1               BANK_GAME_RTS:
0000C8r 1  48               pha                     ; push our current A value to not disturb it
0000C9r 1  A9 06            lda #6                  ; set mmc3 state for game mode
0000CBr 1  8D 00 80         sta $8000               ;
0000CEr 1  A9 8C            lda #GameBank           ;
0000D0r 1  8D 01 80         sta $8001               ;
0000D3r 1  A9 07            lda #7                  ;
0000D5r 1  8D 00 80         sta $8000               ;
0000D8r 1  A9 8D            lda #GameBank+1         ;
0000DAr 1  8D 01 80         sta $8001               ;
0000DDr 1  68               pla                     ; restore previous A value
0000DEr 1  60               rts                     ;
0000DFr 1               ; ================================================================
0000DFr 1               
0000DFr 1               ; ================================================================
0000DFr 1               ;  Load into title screen and return control
0000DFr 1               ; ----------------------------------------------------------------
0000DFr 1               BANK_TITLE_RTS:
0000DFr 1  48               pha                     ; push our current A value to not disturb it
0000E0r 1  A9 06            lda #6                  ; set mmc3 state for title mode
0000E2r 1  8D 00 80         sta $8000               ;
0000E5r 1  A9 80            lda #PractiseBank       ;
0000E7r 1  8D 01 80         sta $8001               ;
0000EAr 1  A9 07            lda #7                  ;
0000ECr 1  8D 00 80         sta $8000               ;
0000EFr 1  A9 81            lda #PractiseBank+1     ;
0000F1r 1  8D 01 80         sta $8001               ;
0000F4r 1  68               pla                     ; restore previous A value
0000F5r 1  60               rts                     ;
0000F6r 1               ; ================================================================
0000F6r 1               
0000F6r 1               ; interrupt handlers
0000F6r 1               .segment "PRACTISE_VEC"
000000r 1  rr rr        .word BANK_GAME_NMI
000002r 1  rr rr        .word ColdTitleReset
000004r 1  rr rr        .word IRQHandler
000004r 1               
