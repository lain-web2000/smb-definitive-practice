000048r 3               
000048r 3               ; ===========================================================================
000048r 3               ;  Attempt to find the level selected on the menu screen
000048r 3               ; ---------------------------------------------------------------------------
000048r 3               BANK_AdvanceToLevel:
000048r 3  AD 5F 07         lda WorldNumber                     ; check selected world number
00004Br 3  C9 09            cmp #$09                            ; did we select a 2J world?
00004Dr 3  90 05            bcc @SMB1Levels                     ; if not, branch ahead to store world
00004Fr 3  EE FB 07         inc HardWorldFlag                   ; otherwise increment flag for 2J levels
000052r 3  E9 09            sbc #$09                            ; subtract world number by 9 to correctly store
000054r 3               @SMB1Levels:
000054r 3  8D 5F 07         sta WorldNumber                     ; store the result in the world number
000057r 3  C9 09            cmp #$09                            ; did we select a letter world?
000059r 3  90 03            bcc @NumberWorlds                   ; if not, branch ahead
00005Br 3  EE 6A 07         inc PrimaryHardMode                 ; otherwise set hard mode for letter worlds
00005Er 3               @NumberWorlds:
00005Er 3  20 rr rr         jsr BANK_LEVELBANK_RTS              ; switch to the level banks
000061r 3                   @AreaNumber = $0                    ;
000061r 3  A2 00            ldx #0                              ;
000063r 3  86 00            stx @AreaNumber                     ; clear temp area number
000065r 3  8E 60 07         stx AreaNumber                      ; clear area number
000068r 3  AE 5C 07         ldx LevelNumber                     ; get how many levels to advance
00006Br 3  F0 17            beq @LevelFound                     ; if we're on the first level, we're done
00006Dr 3               @NextArea:                              ;
00006Dr 3  20 rr rr         jsr RELOCATE_LoadAreaPointer        ; otherwise, load the area pointer
000070r 3  20 rr rr         jsr RELOCATE_GetAreaDataAddrs       ; then get the pointer to the area data
000073r 3  EE 60 07         inc AreaNumber                      ; advance area pointer
000076r 3  AD 10 07         lda PlayerEntranceCtrl              ; get what kind of entry this level has
000079r 3  29 04            and #%00000100                      ; check if it's a controllable area
00007Br 3  F0 04            beq @AreaOK                         ; yes - advance to next level
00007Dr 3  E6 00            inc @AreaNumber                     ; yes - increment temp area number
00007Fr 3  50 EC            bvc @NextArea                       ; and check next area
000081r 3               @AreaOK:                                ;
000081r 3  CA               dex                                 ; decrement number of levels we need to advance
000082r 3  D0 E9            bne @NextArea                       ; and keep running if we haven't reached our level
000084r 3               @LevelFound:                            ;
000084r 3  18               clc                                 ;
000085r 3  AD 5C 07         lda LevelNumber                     ; get level we are starting on
000088r 3  65 00            adc @AreaNumber                     ; and add how many areas we needed to skip
00008Ar 3  8D 60 07         sta AreaNumber                      ; and store that as the area number
00008Dr 3  A9 00            lda #0                              ; clear sound
00008Fr 3  8D 11 40         sta SND_DELTA_REG+1                 ;
000092r 3  20 rr rr         jsr RELOCATE_LoadAreaPointer        ; reload pointers for this area
000095r 3  20 rr rr         jsr RELOCATE_GetAreaDataAddrs       ;
000098r 3  20 rr rr         jsr BANK_GAME_RTS                   ; load game bank
00009Br 3  A9 A5            lda #$a5                            ;
00009Dr 3  4C rr rr         jmp RELOCATE_GL_ENTER               ; then start the game
0000A0r 3               ; ===========================================================================
0000A0r 3               
0000A0r 3               ; return to previous segment
0000A0r 3               .popseg
