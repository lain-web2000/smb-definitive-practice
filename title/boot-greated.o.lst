000812r 3  0A               asl a                             ; get offset into pointer table
000813r 3  AA               tax                               ;
000814r 3  BD rr rr         lda @Strings,x                    ; copy string pointer to menu text pointer
000817r 3  85 C3            sta MenuTextPtr                   ;
000819r 3  BD rr rr         lda @Strings+1,x                  ;
00081Cr 3  85 C4            sta MenuTextPtr+1                 ;
00081Er 3  A9 03            lda #3                            ; set fixed string length
000820r 3  85 C2            sta MenuTextLen                   ;
000822r 3  4C rr rr         jmp DrawValueString               ; and draw the string
000825r 3               
000825r 3               @Strings:
000825r 3  rr rr        .word @Str0
000827r 3  rr rr        .word @Str1
