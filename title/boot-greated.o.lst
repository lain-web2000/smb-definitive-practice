000020r 3  20 rr rr     jsr WriteScoreAndCoinTally ;write player's score and coin tally to screen
000023r 3  20 rr rr     jsr BANK_TITLE_RTS
000026r 3  20 rr rr     jsr PractiseWriteBottomStatusLine
000029r 3  4C rr rr     jmp BANK_GAME_RTS
