0007EEr 3  0A               asl a                             ; get offset into pointer table
0007EFr 3  AA               tax                               ;
0007F0r 3  BD rr rr         lda @Strings,x                    ; copy string pointer to menu text pointer
0007F3r 3  85 C3            sta MenuTextPtr                   ;
0007F5r 3  BD rr rr         lda @Strings+1,x                  ;
0007F8r 3  85 C4            sta MenuTextPtr+1                 ;
0007FAr 3  A9 05            lda #5                            ; set fixed string length
0007FCr 3  85 C2            sta MenuTextLen                   ;
0007FEr 3  4C rr rr         jmp DrawValueString               ; and draw the string
000801r 3               
000801r 3               @Strings:
000801r 3  rr rr        .word @Str0
000803r 3  rr rr        .word @Str1
000805r 3               
000805r 3  16 0A 1B 12  @Str0: .byte "MARIO"
000809r 3  18           
00080Ar 3  15 1E 12 10  @Str1: .byte "LUIGI"
00080Er 3  12           
